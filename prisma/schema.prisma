/// アプリ操作ユーザー記録
/// 認証済みで操作したユーザーを記録し、メンバー招待候補の母集団として使用する。
/// user_id は UNIQUE（最新 last_seen_at で上書きされる）。
model AppActivityLog {
  id         String   @id @default(uuid())
  /// Supabase Auth の userId
  userId     String   @unique @map("user_id")
  /// メールアドレス（Supabase Auth から取得できた場合のみ格納）
  email      String?
  /// 最終操作日時（upsert で更新）
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([lastSeenAt])
  // /api/oas/[id]/members で `where: { lastSeenAt: { gte }, userId: { notIn } }, take: 50` を実行する。
  // 単独の lastSeenAt index は範囲条件の絞り込みには効くが、userId の notIn フィルタは
  // index 上で評価できず、レコードに heap fetch して評価する必要がある。
  // (lastSeenAt, userId) の複合 index を追加することで、PostgreSQL は index scan のみで
  // 範囲条件＋userId 比較の両方を完結でき、heap fetch を避けやすくなる。
  @@index([lastSeenAt, userId])
  @@map("app_activity_logs")
}

/// オンボーディング各ステップへの到達を記録するテーブル。
/// @@unique([workId, step]) により、1作品につき各ステップは初回のみ記録される。
