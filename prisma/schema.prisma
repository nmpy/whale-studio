generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Oa {
  id                    String                 @id @default(uuid())
  title                 String
  description           String?
  channelId             String                 @map("channel_id")
  channelSecret         String                 @map("channel_secret")
  channelAccessToken    String                 @map("channel_access_token")
  /// "draft" | "active" | "paused"
  publishStatus         String                 @default("draft") @map("publish_status")
  /// LINE リッチメニュー ID（LINE API で作成・適用したとき保存する）
  richMenuId            String?                @map("rich_menu_id")
  /// Google Sheets スプレッドシート ID（設定時は Sheets からシナリオを読み込む）
  spreadsheetId         String?                @map("spreadsheet_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  /// LINE公式アカウントの Basic ID（例: 613zlngs）。Webhook URL の識別子として使う。
  /// channelId（数値の API 認証用）とは別物。LINE Developers「Basic information」で確認できる。
  lineOaId              String?                @unique @map("line_oa_id")
  /// OA オーナーの識別子（Supabase Auth userId）。RBAC で owner 判定に使う。
  ownerKey              String?                @map("owner_key")
  /// サービス停止日時。null = 稼働中 / 非 null = 停止中（停止された日時を保持）。
  /// 契約終了等で LINE webhook を通常応答させず、署名検証後に
  /// 一律「このアカウントのサービスは終了しました。ご利用ありがとうございました。」
  /// を message event の replyToken に対してのみ返す。
  serviceSuspendedAt    DateTime?              @map("service_suspended_at")
  /// LIFF (LINE Front-end Framework) 設定（OA 単位）。
  /// liffId: この OA 専用の LIFF アプリ ID。未設定時は NEXT_PUBLIC_LIFF_ID にフォールバックする。
  ///   解決順: Oa.liffId → process.env.NEXT_PUBLIC_LIFF_ID → 未設定（管理画面/Runtime でエラー表示）。
  liffId                String?                @map("liff_id")
  /// LINE Developers Console で設定した Endpoint URL のメモ（任意・表示確認用）。
  /// 実際の Runtime 挙動には影響しない（推奨値は app の /liff）。
  liffEndpointUrl       String?                @map("liff_endpoint_url")
  /// QR 読み取り（liff.scanCodeV2）導線を使う想定か（UI 表示フラグ）。
  /// ※ 実際に動かすには LINE Developers Console の LIFF 設定で Scan QR を ON にする必要がある。
  liffScanQrEnabled     Boolean                @default(false) @map("liff_scan_qr_enabled")
  /// 利用区分（個人利用 / 法人利用）。オーナー / platform admin 表示モードでの区別用。
  /// Phase2 で追加済みの enum BusinessUsageType を再利用する。既存 OA は default = personal。
  /// 法人招待リンク (business_invite_links.usage_type) とは別物（自動連携はしない）。
  usageType             BusinessUsageType      @default(personal) @map("usage_type")
  /// あいさつメッセージ（OA単位）。友だち追加時に送る文面。null = OA未設定 →
  /// 実行時は active Work の welcome_message にフォールバック（移行期互換・PR-1）。
  welcomeMessage        String?                @map("welcome_message")
  /// 友だち追加時の動作（OA単位）。"auto_start" | "welcome_wait" | "none"。
  /// null = OA未設定 → 実行時は active Work の follow_action にフォールバック。
  followAction          String?                @map("follow_action")
  friendAddSettings     FriendAddSettings?
  globalCommands        GlobalCommand[]
  hintLogs              HintLog[]
  invitations           Invitation[]
  memberInvites         MemberInvite[]
  studioInvites         StudioInvite[]
  liffSubmissions       LiffSubmission[]
  onboardingEvents      OnboardingEvent[]
  richMenus             RichMenu[]
  riddles               Riddle[]               @relation("OaRiddles")
  segments              Segment[]
  snsPosts              SnsPost[]
  xPosts                XPost[]
  subscription          Subscription?
  trackings             Tracking[]
  userTrackings         UserTracking[]
  works                 Work[]
  workspaceMembers      WorkspaceMember[]
  entitlements          OaEntitlement[]
  liveSessions          LiveSession[]
  liveParticipants      LiveParticipant[]
  liveEventLogs         LiveEventLog[]
  liveActors            LiveActor[]
  liveActorInvites      LiveActorInvite[]
  liveAssignments       LiveAssignment[]
  liveActorInstructions LiveActorInstruction[]
  liveTeams             LiveTeam[]
  liveImportPresets     LiveImportPreset[]
  liveScripts           LiveScript[]
  liveCues              LiveCue[]

  @@index([title])
  @@index([publishStatus])
  @@index([createdAt])
  @@index([serviceSuspendedAt])
  @@map("oas")
}

model Work {
  id                   String  @id @default(uuid())
  /// 公開 URL 用の短縮 ID (10 文字、a-z + 0-9)。DB 主キーは引き続き UUID `id` を使用。
  /// URL に出すときだけこの値を使う。生成は PG 関数 gen_unique_public_id() で自動 (migration 参照)。
  publicId             String  @unique @default(dbgenerated("gen_unique_public_id('works'::text)")) @map("public_id")
  oaId                 String  @map("oa_id")
  title                String
  description          String?
  /// "draft" | "active" | "paused"
  publishStatus        String  @default("draft") @map("publish_status")
  sortOrder            Int     @default(0) @map("sort_order")
  /// LIFF プレイヤー機能 (work メニュー + 個別 LIFF ページ) の有効/無効。
  /// false にすると `/liff/w/{publicId}` 系の URL は全て LIFF_DISABLED 応答を返し、
  /// 実機 LIFF アプリからアクセスできなくなる。CMS プレビューは引き続き利用可能。
  /// 既存 work データは default(true) で migrate されるため挙動が変わらない。
  liffEnabled          Boolean @default(true) @map("liff_enabled")
  /// 作品メニューホーム (`/liff/w/{publicId}`) の見出し・説明文・画像など、ホーム全体に紐づく
  /// 任意設定を格納する JSON。キー: { title?, description?, image_url? }。
  /// 未設定 (= 空 `{}`) のときは従来表示（見出し「ホーム」・説明/画像なし）にフォールバックする。
  /// per-page の LiffPageConfig.settingsJson とは別物（ホームは作品単位の概念）。
  liffHomeSettingsJson Json    @default("{}") @map("liff_home_settings_json") @db.JsonB
  /// システムメッセージ（開始/エラー等）送信者として使うキャラクター（任意）
  systemCharacterId    String? @map("system_character_id")
  /// あいさつメッセージ。未開始ユーザーが話しかけたときに送信される導入文（任意）。
  /// 未設定の場合はシステムデフォルト文にフォールバックする。
  welcomeMessage       String? @map("welcome_message")
  /// あいさつメッセージ（複数件・text/image）。最大5件。要素は WelcomeMessageItem
  /// （{type:"text",text} | {type:"image",imageUrl,previewImageUrl?,altText?}）。
  /// 空配列 `[]` のときは従来どおり welcomeMessage（単一テキスト）にフォールバックする（互換）。
  welcomeMessagesJson  Json    @default("[]") @map("welcome_messages_json") @db.JsonB
  /// あいさつ送信前の「入力中…」演出の待機秒数（0〜8）。0=演出なし（即時 reply）。
  /// loading API はメッセージ通数を消費しないため、push を使わず reply 一括前提のまま演出できる。
  welcomeLoadingSeconds Int    @default(0) @map("welcome_loading_seconds")

  /// 開始キーワード（任意・1作品1キーワード）。同じ OA に複数作品を公開する場合、
  /// ユーザーがこのキーワードを送信するとこの作品が開始される（作品内の応答キーワードより優先）。
  /// 既存作品は null。正規化後、同一 OA の公開中作品間で重複不可（Phase.startTrigger とも重複不可）。
  startKeyword String? @map("start_keyword")

  /// 友だち追加（follow）時の動作（作品単位）:
  ///   "auto_start"    = 友だち追加直後にシナリオを自動開始（既存挙動・既定）。
  ///   "welcome_wait"  = あいさつメッセージを送り、ユーザーの「はじめる」を待つ（progress は作らない）。
  ///   "none"          = 友だち追加時には何も送らない。
  /// 既存作品の挙動を壊さないため default("auto_start")。
  followAction String @default("auto_start") @map("follow_action")

  /// 途中再開機能の有効/無効（作品単位のデフォルト挙動）。
  /// true:  フェーズ途中で離脱したユーザーが開始トリガーを再送したとき、
  ///        「途中から再開する / 最初からやり直す」の選択肢を表示する（従来挙動）。
  /// false: 途中状態があっても選択肢を出さず、通常の開始（最初から）に寄せる。
  /// 既存挙動（常に再開選択肢を表示）を壊さないため default(true)。
  resumeEnabled Boolean @default(true) @map("resume_enabled")

  // ── 演出デフォルト設定（既読・typing・ローディング）──────
  /// 既読制御モード: "inherit" | "immediate" | "delayed" | "before_reply"
  readReceiptMode    String?  @map("read_receipt_mode")
  /// 既読遅延（ms）
  readDelayMs        Int?     @map("read_delay_ms")
  /// typing 風の間を有効にするか
  typingEnabled      Boolean? @map("typing_enabled")
  /// typing 最小待機（ms）
  typingMinMs        Int?     @map("typing_min_ms")
  /// typing 最大待機（ms）
  typingMaxMs        Int?     @map("typing_max_ms")
  /// ローディングアニメーション制御
  loadingEnabled     Boolean? @map("loading_enabled")
  /// ローディング表示閾値（ms）
  loadingThresholdMs Int?     @map("loading_threshold_ms")
  /// ローディング最小秒数
  loadingMinSeconds  Int?     @map("loading_min_seconds")
  /// ローディング最大秒数
  loadingMaxSeconds  Int?     @map("loading_max_seconds")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  characters            Character[]            @relation("WorkCharacters")
  messages              Message[]
  onboardingEvents      OnboardingEvent[]
  onboardingProgress    OnboardingProgress[]
  phases                Phase[]
  riddles               Riddle[]               @relation("WorkRiddles")
  transitions           Transition[]
  userProgress          UserProgress[]
  lineDestinations      LineDestination[]
  liffPageConfigs       LiffPageConfig[]
  liffSurveyResponses   LiffSurveyResponse[]
  liffEventLogs         LiffEventLog[]
  liffSubmissions       LiffSubmission[]
  puzzleDeliveries      PuzzleDelivery[]
  werewolfTitles        WerewolfTitle[]
  locations             Location[]
  checkinWaitTriggers   CheckinWaitTrigger[]
  scheduledLineMessages ScheduledLineMessage[]
  liveSessions          LiveSession[]
  liveScripts           LiveScript[]
  liveCues              LiveCue[]
  xPosts                XPost[]
  oa                    Oa                     @relation(fields: [oaId], references: [id], onDelete: Cascade)
  systemCharacter       Character?             @relation("WorkSystemCharacter", fields: [systemCharacterId], references: [id])

  @@index([oaId])
  @@index([publishStatus])
  @@index([sortOrder])
  /// perf: 作品一覧 `WHERE oa_id=? ORDER BY sort_order` を sorted index scan に乗せる。
  @@index([oaId, sortOrder])
  @@map("works")
}

model Character {
  id            String    @id @default(uuid())
  workId        String    @map("work_id")
  name          String
  /// キャラクター紹介文（任意・nullable）。LIFF 表示は別 PR(CR2)。
  description   String?
  /// "text" | "image"
  iconType      String    @default("text") @map("icon_type")
  iconText      String?   @map("icon_text")
  iconImageUrl  String?   @map("icon_image_url")
  iconColor     String?   @map("icon_color")
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  work          Work      @relation("WorkCharacters", fields: [workId], references: [id], onDelete: Cascade)
  messages      Message[]
  worksAsSystem Work[]    @relation("WorkSystemCharacter")

  @@index([workId])
  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  @@map("characters")
}

model Phase {
  id                      String            @id @default(uuid())
  workId                  String            @map("work_id")
  /// "start" | "normal" | "ending"
  phaseType               String            @default("normal") @map("phase_type")
  name                    String
  description             String?
  sortOrder               Int               @default(0) @map("sort_order")
  isActive                Boolean           @default(true) @map("is_active")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  /// 開始トリガーキーワード（未開始ユーザーがこのキーワードを送信するとシナリオ開始）
  /// phaseType="start" のフェーズのみ有効。
  startTrigger            String?           @map("start_trigger")
  /// 再開時に送るあらすじテキスト（nullable）。
  /// 途中離脱ユーザーが「途中から再開する」を選んだとき、フェーズ先頭メッセージの前に送信される。
  resumeSummary           String?           @map("resume_summary")
  puzzleNextFor           Message[]         @relation("MessageCorrectNextPhase")
  messages                Message[]
  work                    Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  transitionsFrom         Transition[]      @relation("TransitionFrom")
  transitionsTo           Transition[]      @relation("TransitionTo")
  userProgress            UserProgress[]
  liveParticipantsCurrent LiveParticipant[] @relation("LiveParticipantCurrentPhase")
  liveCues                LiveCue[]

  @@index([workId])
  @@index([phaseType])
  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  /// perf: Phase 一覧 `WHERE work_id=? ORDER BY sort_order` を sorted index scan に。
  @@index([workId, sortOrder])
  @@map("phases")
}

model Transition {
  id            String     @id @default(uuid())
  workId        String     @map("work_id")
  fromPhaseId   String     @map("from_phase_id")
  toPhaseId     String     @map("to_phase_id")
  /// ユーザーに表示される選択肢ラベル（例: 「右の扉を開ける」）
  label         String
  /// オプション: 一致キーワードなど Bot が判定に使う条件（テキスト部分一致）
  condition     String?
  /// フラグ条件式（例: "flags.has_key == true" / "flags.score >= 10" / "!flags.used"）
  /// 空の場合は常に有効。現在のユーザーフラグがこの条件を満たす場合のみ遷移を表示・実行できる。
  flagCondition String?    @map("flag_condition")
  /// 遷移実行時に UserProgress.flags へマージする JSON オブジェクト
  /// 例: {"score": 10, "has_key": true} → 既存フラグに上書きマージされる
  setFlags      String     @default("{}") @map("set_flags")
  sortOrder     Int        @default(0) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  fromPhase     Phase      @relation("TransitionFrom", fields: [fromPhaseId], references: [id], onDelete: Cascade)
  toPhase       Phase      @relation("TransitionTo", fields: [toPhaseId], references: [id], onDelete: Cascade)
  work          Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  locations     Location[]

  @@index([workId])
  @@index([fromPhaseId])
  @@index([toPhaseId])
  @@map("transitions")
}

model UserProgress {
  id                 String   @id @default(uuid())
  /// LINE ユーザー ID（本番）またはテスト用任意 ID
  lineUserId         String   @map("line_user_id")
  workId             String   @map("work_id")
  currentPhaseId     String?  @map("current_phase_id")
  reachedEnding      Boolean  @default(false) @map("reached_ending")
  /// JSON 文字列。任意フラグを保存できる（例: {"hint_used": true, "score": 10}）
  /// SQLite は JSON 型非対応のため String で保持し、アプリ層で parse/stringify する
  flags              String   @default("{}") @map("flags")
  /// ユーザー入力で保存された変数（自由入力 / アンケート任意回答などに使用）。
  /// 例: {"userName": "なみぽよ", "favoriteColor": "blue"}
  /// flags とは意味論を分離: flags は条件分岐 / set_flags 用、こちらはユーザー固有データ。
  /// SQLite/PG 共用方針に従い String 保持、アプリ層で parse/stringify する。
  variables          String   @default("{}") @map("variables")
  /// 自由入力待ち状態のメタ情報（null = 通常状態）。
  /// 例: {"messageId":"...", "variableKey":"userName", "nextMessageId":"..."}
  /// Message.freeInputEnabled=true のメッセージ送信時に立ち、次のテキスト入力で消化される。
  waitingForInput    String?  @map("waiting_for_input")
  /// 直近送信した chain の messageId 群（JSON 文字列の string[]）。
  /// QR/Quick Reply の有効範囲（frontier）を「現在地に紐づくものだけ」に限定するために使う。
  /// null = レガシー progress（従来どおりフェーズ全体の QR を走査する後方互換挙動）。
  lastSentMessageIds String?  @map("last_sent_message_ids")
  lastInteractedAt   DateTime @default(now()) @map("last_interacted_at")
  /// プレビューモード（管理者・テスターが疑似プレイする場合 true）
  isPreview          Boolean  @default(false) @map("is_preview")
  /// プレビュー実行者の Supabase userId（isPreview=true のとき格納）
  previewBy          String?  @map("preview_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  currentPhase       Phase?   @relation(fields: [currentPhaseId], references: [id])
  work               Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([lineUserId, workId])
  @@index([lineUserId])
  @@index([workId])
  @@index([lastInteractedAt])
  /// /api/works の `groupBy by: [workId, reachedEnding] where: { workId IN (...), isPreview: false }`
  /// を index-only scan で完結させるための 3 列複合 index。
  /// filter（is_preview）+ groupBy 対象（reached_ending）を全て index 内で評価でき、
  /// 既存 @@index([workId]) のみの場合に発生する heap fetch を回避する。
  @@index([workId, isPreview, reachedEnding])
  @@map("user_progress")
}

model Message {
  id                    String   @id @default(uuid())
  workId                String   @map("work_id")
  phaseId               String?  @map("phase_id")
  characterId           String?  @map("character_id")
  /// "text" | "image" | "riddle" | "video" | "carousel" | "voice"
  messageType           String   @default("text") @map("message_type")
  body                  String?
  assetUrl              String?  @map("asset_url")
  /// 応答キーワード（Bot がこのキーワードを受信したときに送信する）
  triggerKeyword        String?  @map("trigger_keyword")
  /// 送信対象セグメント（"all" | "not_started" | "in_progress" | "completed"）
  targetSegment         String?  @map("target_segment")
  /// 通知メッセージ（テキスト以外の種別で使用。LINE の通知欄に表示される）
  notifyText            String?  @map("notify_text")
  /// 謎 ID（messageType = "riddle" のとき参照する謎）
  riddleId              String?  @map("riddle_id")
  /// クイックリプライ設定（JSON 配列 / null = 未設定）
  /// 構造: [{ label, action, value? }]
  /// action: "text" | "url" | "next" | "hint" | "custom"
  quickReplies          String?  @map("quick_replies")
  /// Flex Message の代替テキスト（messageType = "flex" のとき使用）
  altText               String?  @map("alt_text")
  /// Flex Message の JSON ペイロード（messageType = "flex" のとき使用）
  flexPayloadJson       String?  @map("flex_payload_json")
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  /// メッセージ種別: "start" | "normal" | "response" | "hint" | "puzzle" | "system_notice"
  /// start         = 開始トリガー一致時に送信（kind="start" のメッセージのみ送信）
  /// normal        = フェーズ遷移時に通常送信
  /// response      = 応答キーワード（trigger_keyword）一致時に返信
  /// hint          = ヒント用（将来拡張）
  /// puzzle        = 謎（出題形式）
  /// system_notice = システム通知（入室/退室/通話など、トーク中央に表示する）
  kind                  String   @default("normal") @map("kind")
  /// 正解テキスト（kind="puzzle" のとき必須）
  answer                String?  @map("answer")
  /// 表記ゆれ許容設定（JSON配列文字列: ["exact","ignore_punctuation","normalize_width"]）
  answerMatchType       String   @default("[\"exact\"]") @map("answer_match_type")
  /// 正解時の挙動: "text" | "text_and_transition" | "transition"
  correctAction         String?  @map("correct_action")
  /// 正解後の遷移先フェーズ（correct_action が transition 系のとき必須）
  correctNextPhaseId    String?  @map("correct_next_phase_id")
  /// 正解時メッセージ（任意）
  correctText           String?  @map("correct_text")
  /// 不正解時メッセージ（任意）
  incorrectText         String?  @map("incorrect_text")
  /// ヒントテキスト（任意）
  puzzleHintText        String?  @map("puzzle_hint_text")
  /// 出題形式: "text" | "image" | "video" | "carousel"（kind="puzzle" のとき使用）
  puzzleType            String?  @map("puzzle_type")
  /// 連続送信: このメッセージの後に続けて送信するメッセージ ID（自己参照 FK / null = チェーンなし）
  nextMessageId         String?  @map("next_message_id")
  /// 不正解時クイックリプライ（JSON / QuickReplyItem[]）
  incorrectQuickReplies String?  @map("incorrect_quick_replies")
  /// 前のメッセージ送信後、この発話（メッセージ）を送るまで待機するミリ秒数。0 = 即時送信
  lagMs                 Int      @default(0) @map("lag_ms")
  /// ヒント表示モード: "always"（常時）| "on_wrong"（不正解時のみ）| "hidden"（非表示）
  hintMode              String   @default("always") @map("hint_mode")
  /// 複数正解（JSON 配列文字列: ["りんご","林檎","リンゴ"]）。null/未設定 = 単一 answer のみ使用（後方互換）。
  /// 判定は answer + answers を統合した候補のいずれか一致で正解。answer には先頭候補を保持する。
  answers               String?  @map("answers")
  /// 正解メッセージの発話キャラクター ID（未設定 = 問題本文 characterId → systemSender にフォールバック）。
  /// FK は張らず（hint_character_id と同方針）、送信時に lookup・存在しなければ graceful fallback。
  correctCharacterId    String?  @map("correct_character_id")
  /// 不正解メッセージの発話キャラクター ID（未設定 = 問題本文 characterId → systemSender にフォールバック）。
  incorrectCharacterId  String?  @map("incorrect_character_id")

  // ── 演出設定（既読・typing・ローディング）──────────────
  /// 既読制御モード: "inherit" | "immediate" | "delayed" | "before_reply"
  readReceiptMode    String?  @map("read_receipt_mode")
  /// 既読遅延（ms）。readReceiptMode="delayed" のとき使用
  readDelayMs        Int?     @map("read_delay_ms")
  /// typing 風の間を有効にするか
  typingEnabled      Boolean? @map("typing_enabled")
  /// typing 最小待機（ms）
  typingMinMs        Int?     @map("typing_min_ms")
  /// typing 最大待機（ms）
  typingMaxMs        Int?     @map("typing_max_ms")
  /// ローディングアニメーション制御: true=有効 / false=無効 / null=inherit
  loadingEnabled     Boolean? @map("loading_enabled")
  /// ローディング表示閾値（ms）
  loadingThresholdMs Int?     @map("loading_threshold_ms")
  /// ローディング最小秒数
  loadingMinSeconds  Int?     @map("loading_min_seconds")
  /// ローディング最大秒数
  loadingMaxSeconds  Int?     @map("loading_max_seconds")

  // ── タップ遷移先（画像メッセージ等）──────────────
  /// タップ時の遷移先 destination ID（nullable — null = destination 未使用）
  tapDestinationId String? @map("tap_destination_id")
  /// タップ時の直接URL（destination 未使用時のフォールバック）
  tapUrl           String? @map("tap_url")

  // ── 画像タップ時アクション（messageType="image" 用）─────────────────
  // 画像メッセージをタップしたときに発火するアクション。設定時は LINE 送信側で
  // Image Message → Flex Message (hero image + action) に自動変換する。
  // null/未設定 = アクションなし (= 既存の Image Message として送信)。
  // 既存の tap_destination_id / tap_url は別概念（タップ→Destination 遷移）。
  /// "none" | "message" | "uri" | "liff" | "postback"。null = アクションなし
  imageActionType         String? @map("image_action_type")
  /// type="message" 用: 画像タップ時にプレイヤーから送信されるテキスト
  imageActionText         String? @map("image_action_text")
  /// type="uri" 用: 画像タップ時に開く外部 URL (HTTPS のみ)
  imageActionUrl          String? @map("image_action_url")
  /// type="liff" 用: 画像タップ時に開く LIFF ページ ID
  imageActionLiffPageId   String? @map("image_action_liff_page_id")
  /// type="postback" 用: 画像タップ時の postback data
  imageActionPostbackData String? @map("image_action_postback_data")
  /// type="message_with_phase" 用: 画像タップ送信テキスト受信時に遷移する先フェーズ ID。
  /// LINE payload には載せず（action は message のみ）、webhook 側の遷移解決で参照する。
  imageActionPhaseId      String? @map("image_action_phase_id")

  // ── 自由入力受付（このメッセージ送信後にユーザーの次入力を保存する）──────
  /// true: このメッセージ送信後にユーザーの次のテキスト入力を変数として保存する。
  /// 名前入力 / アンケート自由回答 / 任意テキストの記録 等に使う。
  /// nextMessageId (連続送信) とは意味が違うため別管理。
  freeInputEnabled       Boolean @default(false) @map("free_input_enabled")
  /// 保存先の変数名 (^[a-zA-Z_][a-zA-Z0-9_]*$ で validation)。freeInputEnabled=true のとき必須。
  freeInputVariableKey   String? @map("free_input_variable_key")
  /// 自由入力を受け取った後に送信する次メッセージ ID。自己参照 FK。
  /// freeInputEnabled=true のとき、入力受付完了後にここで指定されたメッセージを送信する。
  freeInputNextMessageId String? @map("free_input_next_message_id")

  // ── 送信後の待機トリガー（地点到着で自動進行）────────────────────────
  // このメッセージ送信後、指定地点(checkin_trigger_location_id)の検知待ち状態に
  // そのユーザーだけを「武装(arm)」する（CheckinWaitTrigger を pending で作成）。
  // 地点で QR/GPS チェックインが成功し、かつ pending がある場合のみ next メッセージを送信し
  // （任意で）next フェーズへ進める。これにより未到達ユーザーへの誤送信・二重送信を防ぐ。
  // FK は張らず（correct_character_id と同方針）、送信/消化時に lookup・graceful fallback。
  /// "qr" | "gps" | "beacon"（null = 待機トリガーなし。beacon の検知消化は次PRで実装）
  checkinTriggerType          String? @map("checkin_trigger_type")
  /// 検知対象の地点(Location.id)。checkinTriggerType 設定時に必須。
  checkinTriggerLocationId    String? @map("checkin_trigger_location_id")
  /// 検知成功時に送る次メッセージ(Message.id・任意)。null = メッセージ送信なし（フェーズ遷移のみ等）。
  checkinTriggerNextMessageId String? @map("checkin_trigger_next_message_id")
  /// 検知成功時に進める次フェーズ(Phase.id・任意)。null = フェーズ遷移なし。
  checkinTriggerNextPhaseId   String? @map("checkin_trigger_next_phase_id")

  // ── 時間差メッセージ（予約送信）の設定（PR-4c-1: 保存のみ。runtime/webhook では未使用）────
  /// 時間差メッセージ設定の JSON 文字列（null = 未設定）。
  /// shape: { enabled, delayMinutes, body, characterId, cancelOnPhaseChange, cancelOnWorkCompleted }。
  /// push 配信（通数消費）として「ユーザー操作の N 分後」に送る予約の設定。実際の予約作成は次 PR で接続。
  scheduledMessageSettings String? @map("scheduled_message_settings")

  character             Character?       @relation(fields: [characterId], references: [id])
  tapDestination        LineDestination? @relation(fields: [tapDestinationId], references: [id], onDelete: SetNull)
  correctNextPhase      Phase?           @relation("MessageCorrectNextPhase", fields: [correctNextPhaseId], references: [id])
  nextMessage           Message?         @relation("MessageChain", fields: [nextMessageId], references: [id])
  prevMessages          Message[]        @relation("MessageChain")
  freeInputNextMessage  Message?         @relation("MessageFreeInputNext", fields: [freeInputNextMessageId], references: [id], onDelete: SetNull)
  freeInputPrevMessages Message[]        @relation("MessageFreeInputNext")
  qrSuccessLocations    Location[]       @relation("LocationQrSuccessMessage")
  puzzleDeliveries      PuzzleDelivery[]
  phase                 Phase?           @relation(fields: [phaseId], references: [id])
  work                  Work             @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([phaseId])
  @@index([characterId])
  @@index([messageType])
  @@index([sortOrder])
  @@index([isActive])
  @@index([freeInputNextMessageId])
  /// perf: メッセージ一覧 `WHERE work_id=? ORDER BY sort_order` を sorted index scan に。
  @@index([workId, sortOrder])
  /// perf: フェーズ詳細でのメッセージ取得 `WHERE work_id=? AND phase_id=? ORDER BY sort_order`。
  @@index([workId, phaseId, sortOrder])
  @@map("messages")
}

/// プレイヤー（lineUserId）に「実際に出題された謎・問題」の履歴。
/// LIFF「謎・問題」ブロックで、過去に出題された問題を一覧するために使う。
/// 記録は puzzle メッセージ送信直後（line.ts の送信関数経由）に行う＝未送信は記録しない。
/// 同一問題の再出題は @@unique で 1 行に集約し、createMany(skipDuplicates) のため
/// deliveredAt は「初回出題日時」を保持する（再出題で更新しない）。
/// 正解状態は別途 UserProgress.flags.solvedPuzzles から導出する（本テーブルには持たない＝最小設計）。
model PuzzleDelivery {
  id          String   @id @default(uuid())
  lineUserId  String   @map("line_user_id")
  workId      String   @map("work_id")
  /// 出題された puzzle の Message.id（kind="puzzle"）。
  messageId   String   @map("message_id")
  deliveredAt DateTime @default(now()) @map("delivered_at")
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([lineUserId, workId, messageId])
  @@index([lineUserId, workId])
  @@index([messageId])
  @@map("puzzle_deliveries")
}

model FriendAddSettings {
  id            String   @id @default(uuid())
  oaId          String   @unique @map("oa_id")
  /// 管理用キャンペーン名（任意）
  campaignName  String?  @map("campaign_name")
  /// 友だち追加 URL（必須）
  addUrl        String   @map("add_url")
  /// QR コード画像 URL（任意・当面未使用）
  qrCodeUrl     String?  @map("qr_code_url")
  /// SNS シェア用 OGP 画像 URL（任意）
  shareImageUrl String?  @map("share_image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  oa            Oa       @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@map("friend_add_settings")
}

model SnsPost {
  id        String   @id @default(uuid())
  oaId      String   @map("oa_id")
  /// "x" | "instagram" | "line" | "other"
  platform  String
  text      String
  imageUrl  String?  @map("image_url")
  targetUrl String?  @map("target_url")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  oa        Oa       @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([order])
  @@map("sns_posts")
}

/// X（旧Twitter）投稿管理。作品（work）単位で告知ポスト・計測URL・UTM を管理する。
/// X API / スクレイピングは使わず、計測は Whale Studio 発行の tracking URL クリックで行う。
model XPost {
  id               String                @id @default(uuid())
  oaId             String                @map("oa_id")
  workId           String                @map("work_id")
  title            String?
  body             String?
  /// ハッシュタグ（JSON 文字列配列。例: ["#WhaleStudio","#LINE謎解き"]）
  hashtags         String?
  imageUrl         String?               @map("image_url")
  uploadedImageUrl String?               @map("uploaded_image_url")
  linkUrl          String?               @map("link_url")
  utmEnabled       Boolean               @default(false) @map("utm_enabled")
  utmName          String?               @map("utm_name")
  utmSource        String?               @map("utm_source")
  utmMedium        String?               @map("utm_medium")
  utmCampaign      String?               @map("utm_campaign")
  utmContent       String?               @map("utm_content")
  utmTerm          String?               @map("utm_term")
  /// UTM 付与後の遷移先 URL（生成結果）
  generatedUrl     String?               @map("generated_url")
  /// 計測URLの短縮コード（/r/[trackingCode]）
  trackingCode     String?               @unique @map("tracking_code")
  /// 計測URL（https://app.whale-studio.app/r/[trackingCode]）
  trackingUrl      String?               @map("tracking_url")
  /// 投稿済みの X 投稿 URL（手入力）
  xPostUrl         String?               @map("x_post_url")
  /// "draft" | "scheduled" | "posted" | "archived"
  status           String                @default("draft")
  note             String?
  postedAt         DateTime?             @map("posted_at")
  scheduledAt      DateTime?             @map("scheduled_at")
  sortOrder        Int                   @default(0) @map("sort_order")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  oa               Oa                    @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work             Work                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  clickEvents      XPostClickEvent[]
  importedMetrics  XPostImportedMetric[]
  mentions         XImportedMention[]

  @@index([oaId])
  @@index([workId])
  @@index([trackingCode])
  @@map("x_posts")
}

/// 計測URL（/r/[trackingCode]）のクリックログ。IP は hash 化して保存（生値は保存しない）。
model XPostClickEvent {
  id             String   @id @default(uuid())
  oaId           String   @map("oa_id")
  workId         String   @map("work_id")
  xPostId        String   @map("x_post_id")
  trackingCode   String   @map("tracking_code")
  destinationUrl String   @map("destination_url")
  referer        String?
  userAgent      String?  @map("user_agent")
  ipHash         String?  @map("ip_hash")
  clickedAt      DateTime @default(now()) @map("clicked_at")
  createdAt      DateTime @default(now()) @map("created_at")
  xPost          XPost    @relation(fields: [xPostId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([workId])
  @@index([xPostId])
  @@index([trackingCode])
  @@map("x_post_click_events")
}

/// CSV インポートした投稿実績（インプレッション等）。X API/スクレイピングは使わず CSV 由来の値のみ。
/// csvUrlClicks は CSV 由来であり、Whale Studio の計測URLクリック（XPostClickEvent）とは別物。
model XPostImportedMetric {
  id              String    @id @default(uuid())
  oaId            String    @map("oa_id")
  workId          String    @map("work_id")
  xPostId         String?   @map("x_post_id")
  xPostUrl        String?   @map("x_post_url")
  xPostExternalId String?   @map("x_post_external_id")
  postTitle       String?   @map("post_title")
  postedAt        DateTime? @map("posted_at")
  impressions     Int       @default(0)
  likes           Int       @default(0)
  reposts         Int       @default(0)
  replies         Int       @default(0)
  quotes          Int       @default(0)
  bookmarks       Int       @default(0)
  csvUrlClicks    Int       @default(0) @map("csv_url_clicks")
  note            String?
  /// 取り込み元の生データ（X投稿エクスポート等）。JSON 文字列。
  rawJson         String?   @map("raw_json")
  importedAt      DateTime  @default(now()) @map("imported_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  xPost           XPost?    @relation(fields: [xPostId], references: [id], onDelete: SetNull)

  @@index([oaId])
  @@index([workId])
  @@index([xPostId])
  @@map("x_post_imported_metrics")
}

/// CSV インポートした口コミ（自然言語処理の対象）。CSV 由来テキストのみ。
model XImportedMention {
  id              String                    @id @default(uuid())
  oaId            String                    @map("oa_id")
  workId          String                    @map("work_id")
  relatedXPostId  String?                   @map("related_x_post_id")
  relatedXPostUrl String?                   @map("related_x_post_url")
  postedAt        DateTime?                 @map("posted_at")
  authorName      String?                   @map("author_name")
  authorHandle    String?                   @map("author_handle")
  text            String
  /// 重複判定用（url が無い口コミのため text の hash）
  textHash        String                    @map("text_hash")
  url             String?
  source          String?
  note            String?
  /// 取り込み元の生データ（X投稿エクスポート等）。JSON 文字列。
  rawJson         String?                   @map("raw_json")
  importedAt      DateTime                  @default(now()) @map("imported_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  relatedXPost    XPost?                    @relation(fields: [relatedXPostId], references: [id], onDelete: SetNull)
  analysis        XImportedMentionAnalysis?

  @@index([oaId])
  @@index([workId])
  @@index([textHash])
  @@index([relatedXPostId])
  @@map("x_imported_mentions")
}

/// 口コミの分析結果（1:1）。ルールベース。将来 LLM 分類に差し替え可能。
model XImportedMentionAnalysis {
  id                String           @id @default(uuid())
  oaId              String           @map("oa_id")
  workId            String           @map("work_id")
  mentionId         String           @unique @map("mention_id")
  /// "positive" | "neutral" | "negative" | "unknown"
  sentiment         String
  sentimentScore    Int?             @map("sentiment_score")
  /// "high" | "medium" | "low" | "unknown"
  repeatIntent      String           @map("repeat_intent")
  repeatIntentScore Int?             @map("repeat_intent_score")
  /// マッチしたキーワード（JSON 文字列配列）
  matchedKeywords   String?          @map("matched_keywords")
  analyzedAt        DateTime         @default(now()) @map("analyzed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  mention           XImportedMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([workId])
  @@map("x_imported_mention_analyses")
}

model RichMenu {
  id                    String         @id @default(uuid())
  oaId                  String         @map("oa_id")
  name                  String
  chatBarText           String         @default("メニュー") @map("chat_bar_text")
  /// "full" (2500×1686) | "compact" (2500×843)
  size                  String         @default("compact") @map("size")
  imageUrl              String?        @map("image_url")
  lineRichMenuId        String?        @map("line_rich_menu_id")
  /// Google Spreadsheet の richmenu_id（スプレッドシート同期時のキー）
  spreadsheetRichMenuId String?        @map("spreadsheet_richmenu_id")
  /// 表示フェーズ: "start" | "playing" | "cleared" | "none"（常時）
  visiblePhase          String?        @map("visible_phase")
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  areas                 RichMenuArea[]
  oa                    Oa             @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([isActive])
  @@index([spreadsheetRichMenuId])
  @@index([visiblePhase])
  @@map("rich_menus")
