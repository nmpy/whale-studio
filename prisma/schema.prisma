model WorkspaceMember {
  id          String       @id @default(uuid())
  /// workspace_id は現在 Oa.id と同値（MVP）
  workspaceId String       @map("workspace_id")
  userId      String       @map("user_id")
  invitedBy   String?      @map("invited_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  /// メールアドレス（招待時・表示用に保存。Supabase Auth の email と同期する）
  email       String?
  /// 招待送信日時
  invitedAt   DateTime?    @map("invited_at")
  /// 招待承認日時（参加確定日）
  joinedAt    DateTime?    @map("joined_at")
  status      MemberStatus @default(active)
  role        MemberRole   @default(viewer)
  /// Whale Studio Live のロール（null = Live 権限なし）。studio の role(MemberRole) とは別軸。
  liveRole    LiveRole?    @map("live_role")
  /// この管理ユーザーに紐づく LINE の userId / UID（分析除外用・任意）。
  /// 制作/運営/テスターが実 LINE で動作確認する場合に、本人の LINE 連携（webhook 経由）または
  /// owner/admin の手入力で設定する。null = 未設定。
  /// Messaging API webhook の source.userId（= UserProgress.lineUserId と同一 Provider）を保存する。
  lineUserId  String?      @map("line_user_id")
  oa          Oa           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  /// 同一 OA 内で同じ lineUserId を複数メンバーに紐づけない（Postgres は NULL を区別＝未設定は重複可）。
  @@unique([workspaceId, lineUserId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("workspace_members")
}

/// 会員（WorkspaceMember）本人が LINE を連携するためのワンタイムトークン。
/// 本人が対象 OA の公式 LINE に連携コードを送ると、webhook が source.userId を取得して
/// workspace_members.line_user_id に保存する（Provider 一致を保証）。token は hash 保存・期限付き・one-time。
model MemberLineLinkToken {
  id                String    @id @default(uuid())
  oaId              String    @map("oa_id")
  workspaceMemberId String    @map("workspace_member_id")
  /// 連携対象の Supabase userId（= WorkspaceMember.userId）。
  userId            String    @map("user_id")
  /// 連携コードの sha256 hash（平文は保存しない）。
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  oa                Oa        @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([expiresAt])
  @@map("member_line_link_tokens")
}

model Invitation {
  id         String     @id @default(uuid())
  oaId       String     @map("oa_id")
  /// 招待先メールアドレス
  email      String
  role       MemberRole @default(editor)
  /// Whale Studio Live のロール（招待時に付与。承諾時に WorkspaceMember.liveRole へ引き継ぐ）。
  liveRole   LiveRole?  @map("live_role")
  /// URL に埋め込む一意トークン（UUID v4 推奨）
  token      String     @unique
  /// 招待送信者（Supabase Auth userId）
  invitedBy  String     @map("invited_by")
  /// トークン有効期限（デフォルト: 招待から 7 日後）
  expiresAt  DateTime   @map("expires_at")
  /// 招待承認日時（null = 未承認）
  acceptedAt DateTime?  @map("accepted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  oa         Oa         @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invitations")
}

/// メールアドレス不要の「招待URL」(URL を知っている人が参加できる単発招待)。
/// 既存 Invitation(メール招待)とは別系統。招待された人は初回登録時に自分でメールを登録する。
/// セキュリティ: 平文 token は DB に保存せず tokenHash(sha256 hex)のみ保存。URL は発行直後のみ表示。
model MemberInvite {
  id               String     @id @default(uuid())
  oaId             String     @map("oa_id")
  role             MemberRole @default(viewer)
  /// 平文 token の sha256 hex(64 char)。平文は保存しない。
  tokenHash        String     @unique @map("token_hash")
  /// 発行者(Supabase Auth userId / owner|admin)
  createdByUserId  String     @map("created_by_user_id")
  /// 受諾したユーザー(Supabase Auth userId)。null = 未受諾。
  acceptedByUserId String?    @map("accepted_by_user_id")
  acceptedAt       DateTime?  @map("accepted_at")
  /// 無効化日時(null = 有効)
  revokedAt        DateTime?  @map("revoked_at")
  /// 有効期限(null = 無期限)。既定は発行から 7 日。
  expiresAt        DateTime?  @map("expires_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  oa               Oa         @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("member_invites")
}

/// スタジオ管理から発行する「招待URL」(StudioInvite)。
/// MemberInvite(OA メンバー招待) / BusinessInviteLink(法人申込キュー) とは別系統の独立モデル。
/// 発行時に「対象 OA・利用区分・プラン権限(課金非連動の付与記録)・ロール・有効期限(発行から7日)」を確定し、
/// 受諾時に対象 OA へ反映する。平文 token は保存せず token_hash(sha256 hex)のみ保存する。
model StudioInvite {
  id               String            @id @default(uuid())
  oaId             String            @map("oa_id")
  /// 付与する利用区分(個人 / 法人)。受諾時に対象 Oa.usageType へ反映する。
  usageType        BusinessUsageType @map("usage_type")
  /// 付与するプラン権限の snapshot(= 課金非連動の grant 記録)。値は PlanTier("basic"|"standard"|"plus"|"pro"|"delegated")。
  /// Stripe の subscription / price / checkout / webhook には一切連動しない(= 実課金は既存フローに委譲)。
  planTier         String            @map("plan_tier")
  /// 付与するロール。owner は URL 招待で配らない(発行 API 側 zod で除外)。
  role             MemberRole        @default(viewer)
  /// 平文 token の sha256 hex(64 char)。平文は保存しない。
  tokenHash        String            @unique @map("token_hash")
  /// 任意メモ(発行先の用途など)。
  note             String?
  /// 招待アクション区分(統合招待UI 用・任意)。例: register_user / member_invite /
  /// register_and_member / corp_register / corp_admin_invite / corp_oa_link 等。
  /// null = 従来の単純付与(usageType + role + planTier)。値の検証は route 側 zod。
  inviteAction     String?           @map("invite_action")
  /// 招待先メールアドレス(任意・個人ユーザー登録向けの表示/照合補助)。null = 指定なし。
  email            String?
  /// 使用上限。既定 1 (= 従来の単発消費)。
  maxUses          Int               @default(1) @map("max_uses")
  /// 使用回数。受諾ごとに +1。usedCount >= maxUses で上限到達。
  usedCount        Int               @default(0) @map("used_count")
  /// 発行者(Supabase Auth userId / 対象 OA の owner|admin もしくは platform owner)。
  createdByUserId  String            @map("created_by_user_id")
  /// 受諾したユーザー(Supabase Auth userId)。null = 未受諾。
  acceptedByUserId String?           @map("accepted_by_user_id")
  acceptedAt       DateTime?         @map("accepted_at")
  /// 無効化日時(null = 有効)。
  revokedAt        DateTime?         @map("revoked_at")
  /// 有効期限。発行から 7 日。期限切れは受諾不可。
  expiresAt        DateTime          @map("expires_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  oa               Oa                @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("studio_invites")
}

