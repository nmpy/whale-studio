/// アプリ操作ユーザー記録
/// 認証済みで操作したユーザーを記録し、メンバー招待候補の母集団として使用する。
/// user_id は UNIQUE（最新 last_seen_at で上書きされる）。
model AppActivityLog {
  id         String   @id @default(uuid())
  /// Supabase Auth の userId
  userId     String   @unique @map("user_id")
  /// メールアドレス（Supabase Auth から取得できた場合のみ格納）
  email      String?
  /// 最終操作日時（upsert で更新）
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([lastSeenAt])
  // /api/oas/[id]/members で `where: { lastSeenAt: { gte }, userId: { notIn } }, take: 50` を実行する。
  // 単独の lastSeenAt index は範囲条件の絞り込みには効くが、userId の notIn フィルタは
  // index 上で評価できず、レコードに heap fetch して評価する必要がある。
  // (lastSeenAt, userId) の複合 index を追加することで、PostgreSQL は index scan のみで
  // 範囲条件＋userId 比較の両方を完結でき、heap fetch を避けやすくなる。
  @@index([lastSeenAt, userId])
  @@map("app_activity_logs")
}

/// オンボーディング各ステップへの到達を記録するテーブル。
/// @@unique([workId, step]) により、1作品につき各ステップは初回のみ記録される。
model OnboardingEvent {
  id        String   @id @default(uuid())
  oaId      String   @map("oa_id")
  workId    String   @map("work_id")
  /// OnboardingStep 定数に対応する文字列
  step      String
  createdAt DateTime @default(now()) @map("created_at")

  oa   Oa   @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, step], name: "workId_step")
  @@index([oaId])
  @@index([workId])
  @@index([createdAt])
  @@map("onboarding_events")
}

/// ユーザー単位のオンボーディング進捗を記録するテーブル。
/// OnboardingEvent（作品単位）とは別に、ユーザー単位でのステップ到達を管理する。
model OnboardingProgress {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  workId          String   @map("work_id")
  step            String
  /// ステップ初回到達日時。upsert で update: {} としているため createdAt と同値になる。
  /// OnboardingEvent との統合後に集計の主軸となるフィールド。
  firstAchievedAt DateTime @default(now()) @map("first_achieved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  work            Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId, step])
  @@index([userId, workId])
  @@index([step])
  @@index([workId])
  @@map("onboarding_progress")
}

/// 課金導線イベントを記録するテーブル。
/// pricing ページ到達・CTA クリック・フィードバック送信などを集計する。
model BillingEvent {
  id        String   @id @default(uuid())
  /// BillingEvent 定数に対応するイベント種別
  event     String
  /// 発火元ユーザーの Supabase Auth userId（未認証の場合は null）
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@map("billing_events")
}

/// 課金導線イベントの詳細ログ。
/// BillingEvent（集計用）とは別に、コンテキスト情報（oa_id / work_id / source）を
/// 保持する詳細ログテーブル。将来的なコホート分析・ユーザー単位の追跡に使用する。
model BillingEventLog {
  id        String   @id @default(uuid())
  /// Supabase Auth の userId（未ログイン時は null）
  userId    String?  @map("user_id")
  /// イベント発生時に参照していた OA（null = OA コンテキスト外）
  oaId      String?  @map("oa_id")
  /// イベント発生時に参照していた作品（null = 作品コンテキスト外）
  workId    String?  @map("work_id")
  /// BillingEvent 定数に対応するイベント種別
  event     String
  /// pricing への流入元・補助情報（例: "header" / "banner" / "gate" / "preview"）
  source    String?
  /// 遷移元プラン名（例: "tester"）。null = コンテキスト不明
  fromPlan  String?  @map("from_plan")
  /// 遷移先プラン名（例: "editor"）。null = コンテキスト不明
  toPlan    String?  @map("to_plan")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@map("billing_event_logs")
}

/// ユーザー行動・エラー・成功イベントの汎用ログ。
/// billing_event_logs より広いスコープで行動追跡に使用する。
/// payload は JSON 文字列でイベント種別ごとの補足情報を格納する。
model EventLog {
  id        String   @id @default(uuid())
  /// Supabase Auth の userId（未認証時は null）
  userId    String?  @map("user_id")
  /// イベント発生時に参照していた OA（null = コンテキスト外）
  oaId      String?  @map("oa_id")
  /// イベント名（例: "screen_view" / "flow_step" / "error"）
  eventName String   @map("event_name")
  /// イベント種別ごとの補足情報 JSON 文字列（例: {"page":"/pricing","source":"header"}）
  payload   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventName])
  @@index([oaId])
  @@index([createdAt])
  @@map("event_logs")
}

/// プラン定義テーブル。各プランの上限・価格を管理する。
/// MVP では tester / editor の 2 プランのみ。enterprise は将来拡張。
model Plan {
  id            String         @id @default(uuid())
  /// プランキー（例: "tester" | "editor" | "enterprise"）
  name          String         @unique
  /// 表示名（例: "テスタープラン"）
  displayName   String         @map("display_name")
  /// 同時に所有できる作品数の上限（-1 = 無制限）
  maxWorks      Int            @default(1) @map("max_works")
  /// 月あたりのプレイヤー上限（-1 = 無制限）
  maxPlayers    Int            @default(-1) @map("max_players")
  /// 月額料金（円）。0 = 無料
  priceMonthly  Int            @default(0) @map("price_monthly")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@index([name])
  @@index([isActive])
  @@map("plans")
}

/// Stripe webhook event の idempotency 制御。
/// 受信した stripeEventId を保存し、再送時の重複処理を防ぐ。
///
/// フロー:
///   1. webhook 受信直後に stripeEventId で create (= reserve)
///   2. 既存 event.id があれば unique 制約違反 → 200 を返してスキップ
///   3. 処理成功時に status="processed" + processedAt セット
///   4. 処理失敗時に status="failed" + errorMessage セット (= Stripe には 200 を返して
///      再送ループを防ぎ、失敗内容は本テーブル + サーバログから後追い確認できる)
model StripeWebhookEvent {
  id            String    @id @default(uuid())
  /// Stripe の event.id (evt_xxx)。再送検知のキー。
  stripeEventId String    @unique @map("stripe_event_id")
  /// Stripe の event.type (例: "checkout.session.completed")。
  eventType     String    @map("event_type")
  /// 処理ステータス。
  ///   "received"  — 受信直後 (= reserve、処理中 or 処理失敗で update されないと残る)
  ///   "processed" — 処理成功
  ///   "failed"    — 処理失敗 (= errorMessage に詳細を残す)
  status        String    @default("received")
  /// 処理失敗時のエラーメッセージ (= 管理者が後から確認するため)。
  errorMessage  String?   @map("error_message")
  /// 受信時刻 (= reserve 時に自動セット)。
  receivedAt    DateTime  @default(now()) @map("received_at")
  /// 処理完了時刻 (= 成功 / 失敗どちらでもセット)。received のままなら null。
  processedAt   DateTime? @map("processed_at")

  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
  @@map("stripe_webhook_events")
}

/// OA 単位のサブスクリプション。1 OA につき 1 レコード（@@unique(oaId)）。
/// status: "active" | "trialing" | "canceled" | "past_due"
model Subscription {
  id                 String    @id @default(uuid())
  oaId               String    @unique @map("oa_id")
  planId             String    @map("plan_id")
  /// "active" | "trialing" | "canceled" | "past_due"
  status             String    @default("trialing")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  canceledAt         DateTime? @map("canceled_at")
  /// 外部決済システムのサブスクリプション ID（Stripe 等。MVP では未使用 = null）
  externalId         String?   @map("external_id")
  /// 付与種別。null=通常/Stripe / "beta"=β版(無期限・Pro Max 相当) / "trial"=7日トライアル。
  /// 運営による手動付与・トライアルを Whale Studio 内部状態として表す（Stripe 非連動）。
  grantType          String?   @map("grant_type")
  /// トライアル終了日時（grantType="trial" のみ）。null=期限なし（β版/通常）。
  /// feature gate の期限判定はこの値を正とする（currentPeriodEnd ではない）。
  trialEndsAt        DateTime? @map("trial_ends_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  oa                 Oa        @relation(fields: [oaId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ────────────────────────────────────────────────
// LineDestination — 再利用可能な遷移先URL定義
// ────────────────────────────────────────────────

model LineDestination {
  id              String         @id @default(uuid())
  workId          String         @map("work_id")
  /// プログラム参照用キー（英数字・ハイフン・アンダースコア）。work 内で unique
  key             String
  /// 管理画面上の表示名
  name            String
  description     String?
  /// "liff" | "internal_url" | "external_url"
  destinationType String         @map("destination_type")
  /// destination_type=liff のとき有効: "work_main" | "custom"
  liffTargetType  String?        @map("liff_target_type")
  /// 遷移先URLまたはパス
  urlOrPath       String?        @map("url_or_path")
  /// 追加クエリパラメータ（JSONB）
  queryParamsJson Json           @default("{}") @map("query_params_json") @db.JsonB
  isEnabled       Boolean        @default(true) @map("is_enabled")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  work            Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// この destination を参照しているメッセージ（逆参照）
  messages        Message[]
  /// この destination を参照しているリッチメニューエリア（逆参照）
  richMenuAreas   RichMenuArea[]

  @@unique([workId, key])
  @@index([workId])
  @@index([destinationType])
  @@index([isEnabled])
  @@map("line_destinations")
}

// ────────────────────────────────────────────────
// BeaconTrigger / BeaconEventLog — LINE Beacon webhook
// ────────────────────────────────────────────────
//
// LINE 公式アカウントに紐づけたビーコン端末（HWID）の受信圏に
// ユーザーが入ったとき、Whale Studio で設定したアクションを発火する。
// MVP では beacon.type = "enter" のみを実行対象にする。
// 重要導線では QR / GPS の代替導線を併用する想定。

model BeaconTrigger {
  id                 String    @id @default(uuid())
  oaId               String    @map("oa_id")
  /// 任意の所属作品（作品スコープでアクションを実行したい場合）
  workId             String?   @map("work_id")
  /// 任意の紐づけ地点(Location.id)。設定すると、この beacon 検知時に
  /// 「送信後の待機トリガー(CheckinWaitTrigger)」をこの地点で照合・消化できる（地点到着で自動進行）。
  /// 既存 BeaconTrigger アクションとは独立。null = 待機トリガー連携なし（従来どおり）。
  locationId         String?   @map("location_id")
  name               String
  /// 正規化済み HWID（小文字英数字のみ）
  hwid               String
  enabled            Boolean   @default(true)
  /// 発火対象イベント種別（CSV）。MVP では "enter" のみサポート
  eventTypes         String    @default("enter") @map("event_types")
  /// 同一ユーザー × 同一トリガーの再発火防止（秒）。デフォルト 300 = 5 分
  cooldownSeconds    Int       @default(300) @map("cooldown_seconds")
  /// 同一ユーザーには1回だけ発火する（成功ログが1件でもあれば以降スキップ）
  oncePerUser        Boolean   @default(false) @map("once_per_user")
  /// 同一ユーザーへの最大発火回数（null = 無制限）
  maxTriggersPerUser Int?      @map("max_triggers_per_user")
  /// 有効期間の開始（null = 制限なし）。これより前は発火しない
  validFrom          DateTime? @map("valid_from")
  /// 有効期間の終了（null = 制限なし）。これより後は発火しない
  validTo            DateTime? @map("valid_to")
  /// 運用メモ（任意・管理画面表示用）
  note               String?
  /// アクション種別: "message" | "send_message" | "destination" | "noop"
  actionType         String    @map("action_type")
  /// アクション固有の payload（JSON）
  /// - message:       { message_id: string }（登録済みメッセージ/チェーンを送信）
  /// - send_message:  { text: string }
  /// - destination:   { destination_id: string, text?: string }
  actionPayload      Json?     @map("action_payload") @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  events   BeaconEventLog[]
  location Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([oaId, hwid])
  @@index([oaId])
  @@index([workId])
  @@index([locationId])
  @@map("beacon_triggers")
}

model BeaconEventLog {
  id              String   @id @default(uuid())
  oaId            String   @map("oa_id")
  workId          String?  @map("work_id")
  beaconTriggerId String?  @map("beacon_trigger_id")
  lineUserId      String?  @map("line_user_id")
  hwid            String
  /// "enter" | "stay" | "banner"
  beaconType      String   @map("beacon_type")
  /// LINE Beacon の dm（device message）。任意
  deviceMessage   String?  @map("device_message")
  /// LINE webhook event の webhookEventId（重複排除キー）
  webhookEventId  String   @unique @map("webhook_event_id")
  isRedelivery    Boolean  @default(false) @map("is_redelivery")
  /// 既存値: "sent" | "matched" | "ignored" | "cooldown" | "unknown_beacon"
  ///         | "service_stopped" | "plan_blocked" | "message_not_configured" | "failed"
  /// 追加値: "skipped_invalid_period" | "skipped_once_per_user" | "skipped_max_per_user"
  actionStatus    String   @map("action_status")
  errorMessage    String?  @map("error_message")
  /// 送信した Message の id（action_type="message" のとき）。任意
  messageId       String?  @map("message_id")
  /// 疑似発火テスト（管理画面のテスト発火）由来のログか
  isTest          Boolean  @default(false) @map("is_test")
  rawEvent        Json?    @map("raw_event") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")

  beaconTrigger BeaconTrigger? @relation(fields: [beaconTriggerId], references: [id], onDelete: SetNull)

  @@index([oaId, hwid])
  @@index([lineUserId])
  @@index([createdAt])
  @@map("beacon_event_logs")
}

// ────────────────────────────────────────────────
// Location — ビーコン / QR チェックインポイント
// ────────────────────────────────────────────────

model Location {
  id                  String               @id @default(uuid())
  /// 公開 URL 用の短縮 ID (10 文字、a-z + 0-9)。チェックイン URL で使う。
  publicId            String               @unique @default(dbgenerated("gen_unique_public_id('locations'::text)")) @map("public_id")
  workId              String               @map("work_id")
  name                String
  description         String?
  /// Bluetooth ビーコン UUID（任意 — 未設定時は QR コードのみ）
  beaconUuid          String?              @map("beacon_uuid")
  beaconMajor         Int?                 @map("beacon_major")
  beaconMinor         Int?                 @map("beacon_minor")
  /// GPS チェックイン: 緯度
  latitude            Float?
  /// GPS チェックイン: 経度
  longitude           Float?
  /// GPS チェックイン: 許容半径（メートル）
  radiusMeters        Int?                 @map("radius_meters")
  /// @deprecated checkinMode から導出される。将来削除予定。
  /// 削除条件: (1) API レスポンスから gps_enabled を除外 (2) 旧クライアント互換が不要
  /// 現在は checkinMode 保存時に deriveGpsEnabled() で自動同期される。
  gpsEnabled          Boolean              @default(false) @map("gps_enabled")
  /// チェックイン方式: "qr_only" | "gps_only" | "qr_and_gps"
  checkinMode         String               @default("qr_only") @map("checkin_mode")
  /// チェックインのクールダウン秒数（同一ユーザー×同一ロケーション）。デフォルト 300 = 5分
  cooldownSeconds     Int                  @default(300) @map("cooldown_seconds")
  /// チェックイン時に自動発火する遷移（任意）
  transitionId        String?              @map("transition_id")
  /// QR 読み取り成功時に LINE push 送信するメッセージ（任意 / null = 未設定）。
  /// 設定されていない場合、QR 成功 API は message_not_configured を返し送信しない。
  qrSuccessMessageId  String?              @map("qr_success_message_id")
  /// チェックイン時に UserProgress.flags へマージする JSON オブジェクト
  setFlags            String               @default("{}") @map("set_flags")
  sortOrder           Int                  @default(0) @map("sort_order")
  isActive            Boolean              @default(true) @map("is_active")
  /// スタンプラリー: この地点をスタンプ対象にするか
  stampEnabled        Boolean              @default(true) @map("stamp_enabled")
  /// スタンプ表示名（未設定なら name を使用）
  stampLabel          String?              @map("stamp_label")
  /// スタンプ並び順
  stampOrder          Int?                 @map("stamp_order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  work                Work                 @relation(fields: [workId], references: [id], onDelete: Cascade)
  transition          Transition?          @relation(fields: [transitionId], references: [id], onDelete: SetNull)
  qrSuccessMessage    Message?             @relation("LocationQrSuccessMessage", fields: [qrSuccessMessageId], references: [id], onDelete: SetNull)
  visits              LocationVisit[]
  checkinWaitTriggers CheckinWaitTrigger[]
  beaconTriggers      BeaconTrigger[]

  @@index([workId])
  @@index([beaconUuid, beaconMajor, beaconMinor])
  @@index([isActive])
  @@index([qrSuccessMessageId])
  @@map("locations")
}

/// 送信後の待機トリガー（地点到着で自動進行）の per-user pending 状態。
/// Message.checkinTrigger* を持つメッセージが送信されると、そのユーザー向けに pending で1行作成(arm)。
/// 対象地点で QR/GPS チェックインが成功し、かつ pending がある場合のみ next メッセージ送信 + 任意フェーズ遷移を行い、
/// consumed 化して二重送信を防ぐ（atomic claim）。pending が無い検知は何も送信しない（未到達ユーザーへの誤送信防止）。
/// triggerType に "beacon" を持てる設計だが、beacon の検知側 consume は次PRで実装する。
model CheckinWaitTrigger {
  id              String    @id @default(uuid())
  oaId            String    @map("oa_id")
  workId          String    @map("work_id")
  /// 待機対象ユーザー（LINE ユーザー ID / テスト用任意 ID）
  lineUserId      String    @map("line_user_id")
  /// 武装のきっかけになった送信メッセージ(Message.id)。FK は張らず graceful lookup。
  sourceMessageId String?   @map("source_message_id")
  /// 武装時のフェーズ(Phase.id・参考/将来のゲート用)。FK は張らず graceful lookup。
  phaseId         String?   @map("phase_id")
  /// 検知対象の地点B
  locationId      String    @map("location_id")
  /// 検知種別: "qr" | "gps" | "beacon"
  triggerType     String    @map("trigger_type")
  /// 検知成功時に送る次メッセージ(Message.id・任意)。FK は張らず graceful lookup。
  nextMessageId   String?   @map("next_message_id")
  /// 検知成功時に進める次フェーズ(Phase.id・任意)。FK は張らず graceful lookup。
  nextPhaseId     String?   @map("next_phase_id")
  /// "pending" | "consumed" | "expired" | "canceled"
  status          String    @default("pending")
  /// 二重武装防止の冪等キー（非 null）。`${lineUserId}:${locationId}:${sourceMessageId|_}:${triggerType}`。
  /// 同一ユーザー×地点×source×種別の再送は1行を upsert で再 arm する（nullable unique の不安定さを避けるため非 null）。
  idempotencyKey  String    @map("idempotency_key")
  armedAt         DateTime  @default(now()) @map("armed_at")
  consumedAt      DateTime? @map("consumed_at")
  /// 有効期限（任意・将来用）。過ぎた pending は consume 対象外にできる。
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  work     Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([lineUserId, workId, status])
  @@index([locationId, status])
  @@index([workId])
  @@map("checkin_wait_triggers")
}

/// 時間差メッセージ（予約送信）の予約レコード。
/// ユーザー操作の N 分後に push 配信する予約を「作るだけ」のテーブル（PR-3）。
/// 実 push 送信・cron 実行は PR-4。reply ではなく push 配信（通数消費）として扱う。
model ScheduledLineMessage {
  id               String    @id @default(uuid())
  oaId             String    @map("oa_id")
  workId           String    @map("work_id")
  /// 予約対象ユーザー（LINE ユーザー ID / テスト用任意 ID）
  lineUserId       String    @map("line_user_id")
  /// 予約作成時の進行(UserProgress.id・任意)。FK は張らず graceful lookup。
  userProgressId   String?   @map("user_progress_id")
  /// 予約作成時のフェーズ(Phase.id・任意)。送信前キャンセル判定（phase_changed）の基準。
  phaseId          String?   @map("phase_id")
  /// 予約のきっかけメッセージ(Message.id・任意)。FK は張らず graceful lookup。
  sourceMessageId  String?   @map("source_message_id")
  /// 予約のトリガー種別: "message_action" | "keyword" など（将来拡張）。
  triggerType      String    @map("trigger_type")
  /// トリガーイベント識別子（任意・冪等キーの一部に使う）。
  triggerEventId   String?   @map("trigger_event_id")
  /// 送信予定時刻（UTC）。これ以降に PR-4 の cron が push 送信する。
  dueAt            DateTime  @map("due_at")
  /// "pending" | "sending" | "sent" | "canceled" | "failed"。PR-3 では pending/canceled を使用。
  /// sending/sent/failed は PR-4（実送信）用に enum 値だけ先に用意。
  status           String    @default("pending")
  /// 送信予定メッセージ内容の JSON 文字列（message_type / body / character 等。将来の push で使う形）。
  payloadJson      String    @map("payload_json")
  /// キャンセル条件の JSON 文字列（phase_changed / work_completed / same_trigger 評価情報）。
  cancelPolicyJson String?   @map("cancel_policy_json")
  /// 二重予約防止の冪等キー（非 null・@@unique）。
  /// `${lineUserId}:${workId}:${sourceMessageId|_}:${triggerEventId|_}:${dueAtBucket}`。
  idempotencyKey   String    @map("idempotency_key")
  /// PR-4 用: LINE 送信リクエスト識別子（任意）。
  lineRequestId    String?   @map("line_request_id")
  retryCount       Int       @default(0) @map("retry_count")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  sentAt           DateTime? @map("sent_at")
  canceledAt       DateTime? @map("canceled_at")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([status, dueAt])
  @@index([lineUserId, workId, status])
  @@index([workId])
  @@map("scheduled_line_messages")
}

model LocationVisit {
  id             String   @id @default(uuid())
  lineUserId     String   @map("line_user_id")
  locationId     String   @map("location_id")
  workId         String   @map("work_id")
  /// チェックイン方式: "qr" | "gps" | "beacon"
  checkinMethod  String   @default("qr") @map("checkin_method")
  /// GPS チェックイン時の実測距離（メートル）
  distanceMeters Float?   @map("distance_meters")
  visitedAt      DateTime @default(now()) @map("visited_at")
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([lineUserId, locationId])
  @@index([workId])
  @@index([visitedAt])
  @@map("location_visits")
}

/// GPS チェックイン試行ログ（成功・失敗問わず記録）
/// LocationVisit は成功時のみ。このテーブルは全試行を記録し、成功率分析に使う。
model CheckinAttempt {
  id             String   @id @default(uuid())
  workId         String   @map("work_id")
  locationId     String   @map("location_id")
  lineUserId     String   @map("line_user_id")
  /// チェックイン方式: "gps" | "beacon" など（QR は試行ログ不要のため基本 GPS のみ）
  method         String   @default("gps")
  /// "success" | "out_of_range" | "permission_denied" | "gps_unavailable"
  /// | "location_not_supported" | "location_config_incomplete" | "invalid_request"
  status         String
  /// 失敗理由の補足（任意）
  failureReason  String?  @map("failure_reason")
  /// サーバー計算の距離（メートル）
  distanceMeters Float?   @map("distance_meters")
  /// クライアント送信の緯度
  lat            Float?
  /// クライアント送信の経度
  lng            Float?
  createdAt      DateTime @default(now()) @map("created_at")

  // dedupe 用: hasDuplicateAttempt() の WHERE 句に最適化
  @@index([workId, locationId, lineUserId, status, createdAt])
  // retention cleanup 用: cleanupOldAttempts() の WHERE createdAt < cutoff
  @@index([createdAt])
  // work/location 単位の集計用 (Audience stats)
  @@index([workId, status])
  @@map("checkin_attempts")
}

// ────────────────────────────────────────────────
// LIFF ページ設定
// ────────────────────────────────────────────────

model LiffPageConfig {
  id             String           @id @default(uuid())
  /// 公開 URL 用の短縮 ID (10 文字、a-z + 0-9)。LIFF プレイヤー URL で使う。
  publicId       String           @unique @default(dbgenerated("gen_unique_public_id('liff_page_configs'::text)")) @map("public_id")
  workId         String           @map("work_id")
  isEnabled      Boolean          @default(false) @map("is_enabled")
  /// 一覧表示や公開ページのタイトル。最大 10 文字（バリデーション側で制御）。
  title          String?
  description    String?
  /// "default" | "hint" | "faq" | "survey" | "location"。旧 "hint_site" は "hint" として正規化。
  pageType       String           @default("default") @map("page_type")
  /// "draft" | "published" | "archived"
  publishStatus  String           @default("draft") @map("publish_status")
  /// ページ全体の設定（ヘッダー / テーマ / シェアボタン / 各モード固有設定など）。詳細は LiffPageConfigSettings 型を参照。
  settingsJson   Json             @default("{}") @map("settings_json") @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  blocks         LiffPageBlock[]
  werewolfTitles WerewolfTitle[]
  submissions    LiffSubmission[]
  work           Work             @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([pageType])
  @@index([publishStatus])
  @@map("liff_page_configs")
}

/// LIFF プレイヤー画面で発生したイベント (page_view, block_view, button_click,
/// hint_open, faq_open, survey_submit, checkin_success, checkin_failed) を 1 件 1 行で保存する。
///
/// 集計方針:
///   - work / page / user 単位で count するため index を張る
///   - 詳細メタデータ (button label / location id / hint index 等) は metadataJson に格納
///   - 不正な ID は API 層で弾く想定なので、本テーブルへの FK 違反は基本起きない構造
model LiffEventLog {
  id               String   @id @default(uuid())
  workId           String   @map("work_id")
  /// 対象 LIFF ページ ID。page_view / block_view / button_click / hint_open / faq_open / survey_submit で必須に近い。
  /// checkin_success / checkin_failed は location 起点のため null になることがある。
  liffPageConfigId String?  @map("liff_page_config_id")
  /// 対象ブロック ID。block 起点のイベント (button_click, hint_open, faq_open) で入る。
  liffPageBlockId  String?  @map("liff_page_block_id")
  /// LINE ユーザー ID。LIFF SDK で取得できた場合のみ入る。
  lineUserId       String?  @map("line_user_id")
  /// イベント種別。"page_view" | "block_view" | "button_click" | "hint_open" | "faq_open"
  ///                | "survey_submit" | "checkin_success" | "checkin_failed"
  eventType        String   @map("event_type")
  /// 追加メタデータ (button label, click url, locationId, questionId, hintIndex, distance 等)
  metadataJson     Json?    @map("metadata_json") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([liffPageConfigId])
  @@index([liffPageBlockId])
  @@index([lineUserId])
  @@index([eventType])
  @@index([createdAt])
  @@index([workId, eventType, createdAt])
  @@map("liff_event_logs")
}

/// LIFF Survey モードの回答を 1 回 1 行で保存する。
/// answersJson は質問 id をキー、回答値（string | string[]）を value にもつオブジェクト。
model LiffSurveyResponse {
  id          String   @id @default(uuid())
  workId      String   @map("work_id")
  lineUserId  String?  @map("line_user_id")
  answersJson Json     @map("answers_json") @db.JsonB
  submittedAt DateTime @default(now()) @map("submitted_at")
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([lineUserId])
  @@index([submittedAt])
  @@map("liff_survey_responses")
}

/// LIFF ページ上のフォーム/アンケート送信を 1 件 1 行で保存する（管理画面の「回答結果」用）。
/// answersJson はブロック単位の配列形式: { blocks: [{ blockId, blockType, label, answerType, value }] }。
/// 既存の LiffSurveyResponse（質問id キー）とは別に、pageId/oaId スコープ + 表示名つきで保持する。
model LiffSubmission {
  id          String   @id @default(uuid())
  oaId        String   @map("oa_id")
  workId      String   @map("work_id")
  liffPageId  String   @map("liff_page_id")
  /// LINE ユーザー ID（LIFF profile から取得できた場合のみ）。
  lineUserId  String?  @map("line_user_id")
  /// 将来の Player/Participant 連携用（現状は未使用・null 許容）。
  playerId    String?  @map("player_id")
  displayName String?  @map("display_name")
  /// 回答データ（ブロック単位の配列を含むオブジェクト）。defensive に扱う。
  answersJson Json     @map("answers_json") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  oa       Oa             @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work     Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  liffPage LiffPageConfig @relation(fields: [liffPageId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@index([workId])
  @@index([liffPageId])
  @@index([lineUserId])
  @@index([createdAt])
  @@map("liff_submissions")
}

model LiffPageBlock {
  id                      String         @id @default(uuid())
  pageConfigId            String         @map("page_config_id")
  /// "free_text" | "start_button" | "resume_button" | "progress" | "evidence_list" | "hint_list" | "character_list" | "image" | "video"
  blockType               String         @map("block_type")
  sortOrder               Int            @default(0) @map("sort_order")
  isEnabled               Boolean        @default(true) @map("is_enabled")
  title                   String?
  /// ブロック固有の設定（JSON）
  settingsJson            Json           @default("{}") @map("settings_json") @db.JsonB
  /// 表示条件（"always" | "before_start" | "in_progress" | "completed"）
  visibilityConditionJson String?        @map("visibility_condition_json")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  pageConfig              LiffPageConfig @relation(fields: [pageConfigId], references: [id], onDelete: Cascade)

  @@index([pageConfigId])
  @@index([sortOrder])
  @@index([blockType])
  @@map("liff_page_blocks")
}

// ────────────────────────────────────────────────
// 人狼 / 配役閲覧モード (LiffPageConfig.pageType = "werewolf" の配下)
//
// MVP スコープ:
//   - GM がプレイヤー人数分の配役ページを作成
//   - 各 slot に役職カードを複数枚設定
//   - プレイヤーは QR (/liff/r/[token]) でアクセスして自分の配役を閲覧
//   - GM が「ゲーム開始」を押すまで isStarted=false でロック (cards は返さない)
//
// スコープ外 (将来対応): 夜行動 / 投票 / 進行管理 / 勝敗判定 / 既読確認 /
//                       LINE UID 紐付け / QR 一度きり制限 / 閲覧ログ
// ────────────────────────────────────────────────

/// 人狼モードの 1 ゲーム単位 (例: "テストプレイA卓" "第1ゲーム")。
/// 1 LiffPageConfig(pageType="werewolf") 配下に複数並ぶ想定。
model WerewolfTitle {
  id               String @id @default(uuid())
  /// GM 操作用の短縮 ID (10 文字)。CMS 内 URL や CSV 出力で使う。
  /// プレイヤーが直接見る URL は使わない (= slot.token を使う)。
  publicId         String @unique @default(dbgenerated("gen_unique_public_id('werewolf_titles'::text)")) @map("public_id")
  liffPageConfigId String @map("liff_page_config_id")
  /// LiffPageConfig 経由でも引けるが、work 横断クエリ (e.g. 作品の全ゲーム一覧) を高速化するため冗長保存。
  workId           String @map("work_id")

  title       String
  description String?
  /// プレイ予定日時 (null 可、後から記入できる)
  scheduledAt DateTime? @map("scheduled_at")
  /// プレイヤー人数。スロット数と一致する (POST 時に slots を auto-generate するロジックで担保)
  playerCount Int       @default(0) @map("player_count")
  /// false = 開始前 (プレイヤーは閲覧不可)、true = 開始済み
  isStarted   Boolean   @default(false) @map("is_started")
  /// 開始した日時 (監査用、null = 未開始)
  startedAt   DateTime? @map("started_at")
  /// CMS 上での並び順 (一覧で上から順に並ぶ)
  sortOrder   Int       @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pageConfig LiffPageConfig     @relation(fields: [liffPageConfigId], references: [id], onDelete: Cascade)
  work       Work               @relation(fields: [workId], references: [id], onDelete: Cascade)
  slots      WerewolfRoleSlot[]

  @@index([liffPageConfigId])
  @@index([workId])
  @@index([scheduledAt])
  @@map("werewolf_titles")
}

/// 1 タイトルに対する 1 プレイヤー分の "配役スロット"。
/// QR の 1 単位。token は不可逆な短縮 ID (URL 直叩きで他 slot を推測できないように publicId とは別の opaque な値を発行する)。
model WerewolfRoleSlot {
  id         String  @id @default(uuid())
  titleId    String  @map("title_id")
  /// プレイヤー番号 (1-N、表示順)
  slotNumber Int     @map("slot_number")
  /// GM が付ける管理用ラベル (例: "プレイヤー1" / "Aさん"). プレイヤーには表示しない。
  label      String?
  /// QR / URL に使う opaque token (10 文字、a-z+0-9)。slotNumber と分離することで
  /// URL を見ても他の slot を推測できないようにする。
  token      String  @unique @default(dbgenerated("gen_unique_public_id('werewolf_role_slots'::text)")) @map("token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title WerewolfTitle      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  cards WerewolfRoleCard[]

  /// (title_id, slot_number) でユニーク。1 タイトル内で番号重複を許さない。
  @@unique([titleId, slotNumber])
  @@index([titleId])
  @@map("werewolf_role_slots")
}

/// 1 slot に並ぶ配役カード。1 slot に複数枚並べられる
/// (例: "守護騎士" カード + "賢者の水晶" カード のように役職 + 所持アイテム)。
model WerewolfRoleCard {
  id         String  @id @default(uuid())
  slotId     String  @map("slot_id")
  /// カード上の見出し (例: "守護騎士" / "賢者の水晶")
  title      String
  /// カード上のサブテキスト (例: "あなたは……") — null 可
  subtitle   String?
  /// 小さなバッジ表示 (例: "役職" / "アイテム") — null 可
  badgeLabel String? @map("badge_label")
  /// 本文 (改行 OK)。役職の能力説明などを書く。
  body       String
  /// slot 内での並び順 (小さい順、同値は createdAt 昇順)
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slot WerewolfRoleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@map("werewolf_role_cards")
}

/// メンバーロール（権限階層: owner > admin > editor > tester > viewer）
/// tester: 課金前ユーザー向け体験ロール。コンテンツ作成・編集のみ可能。
enum MemberRole {
  owner
  admin
  editor
  tester
  viewer
}

/// メンバーステータス
enum MemberStatus {
  active
  inactive
  suspended
}

/// ユーザープロフィール（Supabase Auth ユーザーと 1:1）
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  username    String
  /// 氏名（姓・名）/ 会社名。初回登録で取得（既存ユーザー互換のため nullable）。
  lastName    String?  @map("last_name")
  firstName   String?  @map("first_name")
  companyName String?  @map("company_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

/// 利用規約への同意履歴。termsVersion を上げるとユーザーは再同意が必要になる。
model TermsAcceptance {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  termsVersion String   @map("terms_version")
  acceptedAt   DateTime @default(now()) @map("accepted_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, termsVersion])
  @@index([userId])
  @@map("terms_acceptances")
}

/// プライバシーポリシーへの同意履歴。privacyPolicyVersion を上げると再同意が必要。
/// TermsAcceptance と同方針 (= id uuid / userId は Supabase auth.users.id を文字列で保持 /
/// Prisma relation は張らない / @@unique([userId, privacyPolicyVersion]))。
model PrivacyPolicyAcceptance {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  privacyPolicyVersion String   @map("privacy_policy_version")
  acceptedAt           DateTime @default(now()) @map("accepted_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([userId, privacyPolicyVersion])
  @@index([userId])
  @@index([acceptedAt])
  @@map("privacy_policy_acceptances")
}

/// 同意ログ（監査用・追記型）。利用規約 / プライバシーポリシーへの同意を、
/// 同意日時・IP・User-Agent・ドキュメントバージョン・該当 URL とともに記録する。
/// - userId は Supabase auth.users.id を文字列で保持（他テーブルと同方針で Prisma relation は張らない）。
/// - consentType: "terms" | "privacy_policy"（将来の再同意・他種別に拡張しやすいよう文字列で保持）。
/// - 集計用の TermsAcceptance / PrivacyPolicyAcceptance（同意ゲート判定）とは別に、
///   いつ・どの版に・どこから同意したかの監査ログとして残す。
model UserConsentLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  /// "terms" | "privacy_policy"。DB 側で CHECK 制約を付与（migration 参照）。
  consentType     String   @map("consent_type")
  /// 同意した版。監査上「どの版に同意したか」が重要なため non-null（呼び出し側は常に版を渡す）。
  /// non-null にすることで @@unique が NULL 重複を許す問題も回避する。
  documentVersion String   @map("document_version")
  documentUrl     String?  @map("document_url")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  agreedAt        DateTime @default(now()) @map("agreed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  /// 同一ユーザー・同一種別・同一版の同意は 1 行（DB レベルで重複防止＝同時リクエストでも安全）。
  /// 版を上げて再同意した場合は documentVersion が変わるため新規 1 行が積み上がる（監査履歴）。
  /// documentVersion を non-null にしているため NULL による重複すり抜けは起きない。
  @@unique([userId, consentType, documentVersion])
  @@index([userId])
  @@index([consentType])
  @@index([agreedAt])
  @@map("user_consent_logs")
}

/// 規約文書 (= 利用規約 / プライバシーポリシー) のバージョン管理。
///
/// 設計方針:
///   - 編集ごとに既存 row を上書きせず、新しいバージョンとして INSERT する。
///   - `isPublished = true` の row が「現在公開中」を意味する。
///   - 同 type 内で isPublished=true は 1 行のみ (= application 側で制御 / DB 制約は付けない)。
///   - publish 時に既存公開版を isPublished=false に下げ、新版を isPublished=true にする。
///   - DB に公開版がない type は constants/*.ts に fallback (= 既存 /privacy /terms 等が壊れない)。
///   - 同意履歴 (TermsAcceptance / PrivacyPolicyAcceptance) は version 文字列で紐付けるため、
///     旧版を非公開にしても同意履歴は残る。
enum PolicyDocumentType {
  TERMS
  PRIVACY_POLICY
}

model PolicyDocumentVersion {
  id          String             @id @default(uuid())
  type        PolicyDocumentType
  version     String
  title       String
  body        String
  /// 表示用「最終更新日」(= "2026年5月26日" 等の自由文字列)
  lastUpdated String?            @map("last_updated")
  /// 表示用「施行日」(= "2026年5月26日" 等の自由文字列)
  effectiveAt String?            @map("effective_at")
  /// 現在公開中かどうか。同 type 内で true は 1 行のみが運用上の不変条件。
  isPublished Boolean            @default(false) @map("is_published")
  publishedAt DateTime?          @map("published_at")
  createdBy   String?            @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([type, version])
  @@index([type, isPublished])
  @@index([publishedAt])
  @@map("policy_document_versions")
}

/// OA連携の審査ステータス。
/// - DRAFT:      入力途中
/// - SUBMITTED:  ユーザーが提出した直後
/// - IN_REVIEW:  運営が確認中（将来運営側で SUBMITTED→IN_REVIEW へ遷移させる余地）
/// - APPROVED:   承認済み（同時に Oa + WorkspaceMember(owner) が作成される）
/// - REJECTED:   差し戻し（reviewNote を確認してユーザーが再提出する）
enum OaOnboardingStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

/// LINE 公式アカウント連携の審査リクエスト。
/// ユーザーが Step 2 で入力した Channel 情報、Step 3 で提出した権限URLを保持する。
/// 承認時に Oa レコードが作成され、oaId に紐付けられる。
///
/// セキュリティ注意:
///   channel_secret / channel_access_token は現状平文で保存している（既存 Oa と同水準）。
///   将来的に暗号化する場合は専用の secret-store にこのテーブル分も合わせて移行する。
model OaOnboardingRequest {
  id     String             @id @default(uuid())
  userId String             @map("user_id")
  /// 承認時に作成された Oa.id。それ以前は null。
  oaId   String?            @map("oa_id")
  status OaOnboardingStatus @default(DRAFT)

  /// Step 2 の入力（OA 連携情報）。
  oaName        String? @map("oa_name")
  channelId     String? @map("channel_id")
  channelSecret String? @map("channel_secret")
  channelToken  String? @map("channel_access_token")
  basicId       String? @map("basic_id")
  liffId        String? @map("liff_id")

  /// Step 3 で提出された権限URL（運営が確認に使う）。
  permissionUrl String?   @map("permission_url")
  submittedAt   DateTime? @map("submitted_at")

  /// 承認 / 差し戻しの記録。
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String?   @map("reviewed_by")
  reviewNote String?   @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("oa_onboarding_requests")
}

/// Whale Studio Live のメンバーロール（studio の MemberRole とは別軸の権限）。
/// null = Live 権限なし（WorkspaceMember.liveRole / Invitation.liveRole で使用）。
enum LiveRole {
  live_player
  live_admin
  live_actor
  /// Live 全体（Player / Admin / Actor すべて）にアクセスできる liveRole。
  /// studio role の owner とは別物（本体の編集・課金権限は付与しない）。
  live_owner
}

/// OA 単位の機能エンタイトルメント（汎用）。
/// 公開プラン（Subscription/Plan/PlanTier）とは別軸で、法人・個別契約向けの
/// 隠し機能を OA ごとに有効化する。featureKey の第一弾は "whale_studio_live"。
///
/// Phase 1 では有効化 UI を作らず、platform admin が SQL / seed で投入する。
model OaEntitlement {
  id         String   @id @default(uuid())
  oaId       String   @map("oa_id")
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  oa         Oa       @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@unique([oaId, featureKey])
  @@index([oaId])
  @@map("oa_entitlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Whale Studio Live: Phase 2-A データ基盤
// ─────────────────────────────────────────────────────────────────────────────
// 既存の studio role / 課金 / メッセージ / webhook 系には影響しない、独立した
// テーブル群。Live 有効 OA かつ Live 権限を持つユーザーのみが API/UI で参照する。

enum LiveSessionStatus {
  draft
  active
  ended
}

enum LiveParticipantStatus {
  waiting
  active
  stuck
  completed
  dropped
}

enum LiveEventType {
  qr_scanned
  checked_in
  puzzle_solved
  message_sent
  actor_contacted
  note_added
  alert
}

/// Live セッション（= 一回の実イベント / 例: "2026/06/10 12:00回"）。
/// Phase 2-G で workId を追加し、各回は特定作品 (Work) に紐付ける運用へ。
/// startsAt が参加日 + 開始時間の正。
model LiveSession {
  id        String            @id @default(uuid())
  oaId      String            @map("oa_id")
  /// 紐付く Work (= 作品)。既存セッション互換のため nullable。
  /// 新規セッションは UI 上で必須化する。
  workId    String?           @map("work_id")
  name      String
  status    LiveSessionStatus @default(draft)
  startsAt  DateTime?         @map("starts_at")
  endsAt    DateTime?         @map("ends_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  oa        Oa                @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work      Work?             @relation(fields: [workId], references: [id], onDelete: SetNull)

  participants LiveParticipant[]
  eventLogs    LiveEventLog[]
  assignments  LiveAssignment[]
  instructions LiveActorInstruction[]
  teams        LiveTeam[]

  @@index([oaId, createdAt])
  @@index([oaId, status])
  @@index([workId])
  @@map("live_sessions")
}

/// Live セッション参加者（= 運営が管理する体験参加者レコード）。
/// 「Auth user 本人ログインの紐付け」ではなく、Admin / Actor 側から参照する運営用レコード。
/// lineUserId は LINE 連携した場合のみ。displayName で匿名管理も可能。
/// memo は Admin が自由に追記する管理メモ（= 連絡先・特記事項・接触メモ等）。
model LiveParticipant {
  id                String                @id @default(uuid())
  oaId              String                @map("oa_id")
  liveSessionId     String                @map("live_session_id")
  /// Phase 2-G: 同じ回の中で参加者をグループ化する単位 (= LiveTeam 参照)。
  /// onDelete: SetNull で「チームを消しても participant は残す」運用に。
  teamId            String?               @map("team_id")
  displayName       String?               @map("display_name")
  lineUserId        String?               @map("line_user_id")
  status            LiveParticipantStatus @default(waiting)
  /// Phase 2-G: 現在ステップを Work の Phase に紐付ける場合に設定。
  /// 既存 free-text currentStep は legacy fallback として残す (= 旧データ温存)。
  currentPhaseId    String?               @map("current_phase_id")
  currentStep       String?               @map("current_step")
  /// Phase 2-G: チケットサイト由来の予約番号 / 注文番号。CSV import の dedup key。
  reservationNumber String?               @map("reservation_number")
  memo              String?
  lastSeenAt        DateTime?             @map("last_seen_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  oa           Oa                     @relation(fields: [oaId], references: [id], onDelete: Cascade)
  liveSession  LiveSession            @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  team         LiveTeam?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  currentPhase Phase?                 @relation("LiveParticipantCurrentPhase", fields: [currentPhaseId], references: [id], onDelete: SetNull)
  eventLogs    LiveEventLog[]
  assignments  LiveAssignment[]
  instructions LiveActorInstruction[]

  @@index([liveSessionId, createdAt])
  @@index([liveSessionId, status])
  @@index([liveSessionId, teamId])
  @@index([liveSessionId, reservationNumber])
  @@index([oaId])
  @@map("live_participants")
}

/// Phase 2-G: 回 (LiveSession) 内のチーム。
/// 4人1チームを基本として、予約番号ごと or 順番割当 or CSV のチーム名列から作成。
/// reservationNumber は CSV import で予約番号ごとにチーム化したとき使う dedup key。
model LiveTeam {
  id                String   @id @default(uuid())
  oaId              String   @map("oa_id")
  liveSessionId     String   @map("live_session_id")
  name              String
  reservationNumber String?  @map("reservation_number")
  memo              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  oa           Oa                @relation(fields: [oaId], references: [id], onDelete: Cascade)
  liveSession  LiveSession       @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]

  @@index([liveSessionId, createdAt])
  @@index([liveSessionId, reservationNumber])
  @@index([oaId])
  @@map("live_teams")
}

/// Live セッション中のイベントログ（QR スキャン / チェックイン / 詰まり / アラート 等）。
/// liveSessionId / participantId はどちらも nullable（= OA 単位のイベントも記録可能）。
model LiveEventLog {
  id            String        @id @default(uuid())
  oaId          String        @map("oa_id")
  liveSessionId String?       @map("live_session_id")
  participantId String?       @map("participant_id")
  type          LiveEventType
  title         String
  detail        String?
  payload       Json?
  createdAt     DateTime      @default(now()) @map("created_at")

  oa          Oa               @relation(fields: [oaId], references: [id], onDelete: Cascade)
  liveSession LiveSession?     @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  participant LiveParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([liveSessionId, createdAt])
  @@index([participantId, createdAt])
  @@index([oaId, createdAt])
  @@map("live_event_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Whale Studio Live: Phase 2-E Actor assignment / 指示管理
// ─────────────────────────────────────────────────────────────────────────────

enum LiveInstructionPriority {
  low
  normal
  high
}

enum LiveInstructionStatus {
  active
  done
  archived
}

/// Live セッションで現場対応する Actor (= 演者) のレコード。
/// userId は Supabase Auth user_id への optional 紐付け (= live_actor ユーザーが
/// 自分宛ての assignment / instruction を絞り込めるようにするため)。
model LiveActor {
  id            String   @id @default(uuid())
  oaId          String   @map("oa_id")
  displayName   String   @map("display_name")
  /// Supabase Auth user_id への紐付け。null = 未紐付け (= 表示専用 Actor レコード)。
  userId        String?  @map("user_id")
  /// 役柄・キャラクター名 (任意 / 例: 「探偵 A」「店主」)。
  characterName String?  @map("character_name")
  memo          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  oa           Oa                     @relation(fields: [oaId], references: [id], onDelete: Cascade)
  assignments  LiveAssignment[]
  instructions LiveActorInstruction[]
  cues         LiveCue[]
  invites      LiveActorInvite[]

  @@index([oaId, createdAt])
  @@index([oaId, userId])
  @@map("live_actors")
}

/// Phase 2-J: 演者を Actor Console に招待する一回限りの URL token。
/// 平文 token は DB に保存しない。tokenHash (sha256 hex) のみ保存し、URL に含めた
/// 平文 token を受諾時に同じ方式で hash → 一致する row を検索する。
/// 有効性は (expiresAt > now()) AND (usedAt IS NULL) AND (revokedAt IS NULL)。
model LiveActorInvite {
  id              String    @id @default(uuid())
  oaId            String    @map("oa_id")
  actorId         String    @map("actor_id")
  /// sha256 hex 表現の token hash (= 64 char hex)。平文 token は保存しない。
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime? @map("expires_at")
  usedAt          DateTime? @map("used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  oa    Oa        @relation(fields: [oaId], references: [id], onDelete: Cascade)
  actor LiveActor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([oaId, actorId, createdAt])
  @@index([actorId, revokedAt, usedAt])
  @@map("live_actor_invites")
}

/// participant ↔ actor の担当割当。
/// 同セッション内で同じ (participant, actor) の組合せは 1 件のみ (= 重複防止)。
model LiveAssignment {
  id            String   @id @default(uuid())
  oaId          String   @map("oa_id")
  liveSessionId String   @map("live_session_id")
  participantId String   @map("participant_id")
  actorId       String   @map("actor_id")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  oa          Oa              @relation(fields: [oaId], references: [id], onDelete: Cascade)
  liveSession LiveSession     @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  participant LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  actor       LiveActor       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, participantId, actorId])
  @@index([liveSessionId, actorId])
  @@index([liveSessionId, participantId])
  @@index([oaId])
  @@map("live_assignments")
}

/// Admin から Actor 向けに発行する指示 (= ヒント・接触依頼・注意喚起 等)。
/// participantId は「特定参加者についての指示」を示し、null なら「セッション全体への指示」。
/// actorId は「特定 actor 宛て」を示し、null なら「actor 全員向け」。
model LiveActorInstruction {
  id            String                  @id @default(uuid())
  oaId          String                  @map("oa_id")
  liveSessionId String                  @map("live_session_id")
  participantId String?                 @map("participant_id")
  actorId       String?                 @map("actor_id")
  title         String
  body          String
  priority      LiveInstructionPriority @default(normal)
  status        LiveInstructionStatus   @default(active)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  oa          Oa               @relation(fields: [oaId], references: [id], onDelete: Cascade)
  liveSession LiveSession      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  participant LiveParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  actor       LiveActor?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([liveSessionId, status, createdAt])
  @@index([liveSessionId, actorId])
  @@index([liveSessionId, participantId])
  @@index([oaId])
  @@map("live_actor_instructions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2-H: インポートプリセット (OA 単位で保存される列マッピング雛形)
// ─────────────────────────────────────────────────────────────────────────────
/// チケットサイト別の列マッピングや、よく使う設定をプリセット保存する。
/// built-in (= ハードコーディング) のプリセットとは独立。OA 単位で隔離。
model LiveImportPreset {
  id            String   @id @default(uuid())
  oaId          String   @map("oa_id")
  name          String
  description   String?
  /// 列マッピング (= 内部 field 名 → CSV/Excel ヘッダー文字列)。
  /// 例: { "display_name": "氏名", "email": "メールアドレス", ... }
  mapping       Json
  /// "by_reservation" | "by_4" | "by_team_name_column" | "none"
  teamMode      String   @map("team_mode")
  /// "skip" | "overwrite" | "duplicate"
  duplicateMode String   @map("duplicate_mode")
  /// "auto" | "comma" | "tab" (= CSV/TSV のみ意味あり / xlsx では無視)
  delimiter     String?
  /// "auto" | "utf-8" | "shift_jis" (= 将来拡張用 / 現状は auto のみ)
  encoding      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  oa            Oa       @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId, createdAt])
  @@map("live_import_presets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2-I: 台本・セリフ候補 (LiveScript / LiveCue)
// ─────────────────────────────────────────────────────────────────────────────
//
// LiveScript = 作品全体の台本・演出メモ (= Work 単位 / 長文 body)
// LiveCue    = フェーズ別 / Actor 別のセリフ候補 (= Work 単位 / 短〜中文 body)
// workId が null の場合は OA 共通として扱う。

enum LiveCuePriority {
  low
  normal
  high
}

/// 作品全体の台本・演出メモ。
/// 日付・回ごとには変えず、作品単位で一貫して使う前提。
/// workId が null なら OA 共通。
model LiveScript {
  id        String   @id @default(uuid())
  oaId      String   @map("oa_id")
  workId    String?  @map("work_id")
  title     String
  body      String
  memo      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  oa        Oa       @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work      Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@index([oaId, workId, isActive])
  @@index([oaId, createdAt])
  @@map("live_scripts")
}

/// フェーズ別 / Actor 別の セリフ候補。
/// Actor Console で、participant の currentPhase に合致する cue を上位表示する。
/// priority high を上に / sortOrder で同 priority 内の並び順を制御。
model LiveCue {
  id        String          @id @default(uuid())
  oaId      String          @map("oa_id")
  workId    String?         @map("work_id")
  phaseId   String?         @map("phase_id")
  actorId   String?         @map("actor_id")
  title     String
  body      String
  priority  LiveCuePriority @default(normal)
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  oa        Oa              @relation(fields: [oaId], references: [id], onDelete: Cascade)
  work      Work?           @relation(fields: [workId], references: [id], onDelete: SetNull)
  phase     Phase?          @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  actor     LiveActor?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([oaId, workId, isActive])
  @@index([workId, phaseId, isActive])
  @@index([workId, actorId, isActive])
  @@index([oaId, createdAt])
  @@map("live_cues")
}

// ─────────────────────────────────────────────────────────────
// 法人招待リンク (= Phase2 / business invite link)
//   platform admin が「事前に plan / role / usageType を指定した法人申込 URL」を発行する。
//   - URL には token (平文) のみを含め、plan / role / usageType は DB 解決する (= 改ざん防止)。
//   - DB には tokenHash (sha256 hex) のみ保存。平文 token は保存しない。
//   - token URL を開いただけでは usedAt を更新しない (= 申込フォーム送信時のみ)。
//   - 送信時に BusinessInviteApplication を作成し、link.usedAt をセット (= 再申請不可)。
//   - URL アクセスで自動 OA 作成 / 権限付与 / 課金は行わない (= 申請後に運営が手動対応)。
// ─────────────────────────────────────────────────────────────

/// 利用区分。当面は business 固定で発行するが、将来 personal も扱える余地を残す。
enum BusinessUsageType {
  personal
  business
}

model BusinessInviteLink {
  id              String            @id @default(uuid())
  /// sha256 hex(64char) の token hash。平文 token は保存しない。
  tokenHash       String            @unique @map("token_hash")
  /// 発行時に運営が指定する利用区分。URL には出さず DB 解決する。
  usageType       BusinessUsageType @default(business) @map("usage_type")
  /// 付与予定プラン tier (= "basic"|"standard"|"plus"|"pro"|"delegated")。app 側 zod で検証。
  planTier        String            @map("plan_tier")
  /// 付与予定ロール。admin|editor|viewer のみ app 側 zod で許可 (owner/tester は弾く)。
  role            MemberRole        @map("role")
  /// 運営用メモ (= 宛先企業名など)。
  note            String?
  /// 有効期限。null = 無期限。期限切れは申請不可。
  expiresAt       DateTime?         @map("expires_at")
  /// 申込フォーム送信時のみセット。セット済み = 再申請不可。
  usedAt          DateTime?         @map("used_at")
  /// 運営が無効化した日時。
  revokedAt       DateTime?         @map("revoked_at")
  /// 発行した platform admin の Supabase userId。
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  /// 1 link = 1 application (= 再申請不可を DB 制約でも担保)。
  application BusinessInviteApplication?

  @@index([createdByUserId, createdAt])
  @@index([usedAt, revokedAt])
  @@map("business_invite_links")
}

model BusinessInviteApplication {
  id                      String                          @id @default(uuid())
  /// 紐づく link。@unique で 1 link = 1 application を担保。
  linkId                  String                          @unique @map("link_id")
  companyName             String                          @map("company_name")
  contactName             String                          @map("contact_name")
  contactEmail            String                          @map("contact_email")
  /// 申込者の LINE 公式アカウント名 (任意)。
  lineOfficialAccountName String?                         @map("line_official_account_name")
  message                 String?
  /// 申込時点の link スナップショット (= 後から link が変更/revoke されても申請内容を保全)。
  snapshotPlanTier        String                          @map("snapshot_plan_tier")
  snapshotRole            MemberRole                      @map("snapshot_role")
  snapshotUsageType       BusinessUsageType               @map("snapshot_usage_type")
  /// 認証済みなら申込者の Supabase userId (任意)。
  submittedByUserId       String?                         @map("submitted_by_user_id")
  /// 運営の対応ステータス (= pending/approved/rejected)。既存申込は pending。
  /// 承認はあくまで運営管理用のステータス変更。自動 OA 作成 / 権限付与 / 課金はしない。
  status                  BusinessInviteApplicationStatus @default(pending)
  /// 承認 / 却下した日時。
  reviewedAt              DateTime?                       @map("reviewed_at")
  /// 承認 / 却下した platform admin の Supabase userId。
  reviewedByUserId        String?                         @map("reviewed_by_user_id")
  /// 運営メモ (= 承認 / 却下時の任意コメント)。
  reviewNote              String?                         @map("review_note")
  createdAt               DateTime                        @default(now()) @map("created_at")

  link BusinessInviteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("business_invite_applications")
}

/// 法人申込の運営対応ステータス。pending=未対応 / approved=承認済み / rejected=却下。
enum BusinessInviteApplicationStatus {
  pending
  approved
  rejected
}
