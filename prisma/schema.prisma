  @@index([oaId])
  @@index([workId])
  @@index([textHash])
  @@index([relatedXPostId])
  @@map("x_imported_mentions")
}

/// 口コミの分析結果（1:1）。ルールベース。将来 LLM 分類に差し替え可能。
