# ── 依存 ──────────────────────────────────────
node_modules/

# ── Next.js ───────────────────────────────────
.next/
out/

# ── 環境変数 ──────────────────────────────────────────
# 実シークレットは全て Git 管理外。追跡するのは例ファイル(.env.example / .env.local.example)のみ。
# （.env はローカル開発で実 DB URL 等を含みうるため追跡しない。過去に追跡されていたが解除済み）
.env
.env.local
.env.*.local
# 注: .env.example / .env.local.example はプレースホルダのみで安全なため追跡対象（上の .env パターンには非マッチ）。

# ── SQLite DBファイル（ローカル開発用） ─────────
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# ── Prisma ────────────────────────────────────
# generated client は npm install 後に生成されるためトラッキング不要
# node_modules/@prisma/ は上記 node_modules/ で除外済み

# ── OS / エディタ ─────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── ビルド成果物 ──────────────────────────────
dist/
build/
.vercel

# ── TypeScript / tooling 一時ファイル ───────────
# tsc --noEmit / --incremental が更新する増分ビルドキャッシュ。Git 管理不要。
tsconfig.tsbuildinfo

# Claude Code (CLI) のローカル作業状態。プロジェクトには関係しない。
.claude/
